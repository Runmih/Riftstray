        <mxCell id="mih_shield" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#ffffff,#111111);strokeColor=#6c8ebf;fontSize=12;fontColor=light-dark(#111111,#ffffff);" value="&lt;strong&gt;Shield Basics&lt;/strong&gt;:&lt;div&gt;Use Guard to reduce the next physical hit by 35%; Guard ends after one hit.&lt;/div&gt;" vertex="1">
