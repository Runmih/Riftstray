        <mxCell id="mih_base" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;fontStyle=1;fontColor=#111111;" value="Mihata" vertex="1">
          <mxGeometry height="70" width="140" x="410" y="115" as="geometry" />
        </mxCell>
        <mxCell id="mih_sword" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#ffffff,#111111);strokeColor=#6c8ebf;fontSize=12;fontColor=light-dark(#111111,#ffffff);" value="&lt;strong&gt;Sword Basics&lt;/strong&gt;:&lt;div&gt;Reliable melee attacks. +10 Hit when counterattacking an adjacent enemy.&lt;/div&gt;" vertex="1">
