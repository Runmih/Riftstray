        <mxCell id="mih_alchemy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#dae8fc,#15283d);strokeColor=#6c8ebf;fontSize=16;fontStyle=1;fontColor=light-dark(#111111,#ffffff);" value="Synthesis" vertex="1">
