          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="beast_class" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#dae8fc,#15283d);strokeColor=#6c8ebf;fontSize=16;fontStyle=1;fontColor=light-dark(#111111,#ffffff);" value="Beast Form" vertex="1">
          <mxGeometry height="70" width="140" x="460" y="585" as="geometry" />
        </mxCell>
        <mxCell id="beast_benefit" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#d5e8d4,#17331d);strokeColor=#82b366;fontSize=12;fontColor=light-dark(#111111,#ffffff);" value="&lt;b&gt;Regenerating Blood&lt;/b&gt;&lt;div&gt;At the start of Mihata's turn, restore 15% max HP. If she begins the turn on Stone terrain, restore 20% instead.&lt;/div&gt;" vertex="1">
          <mxGeometry height="85" width="330" x="670" y="720" as="geometry" />
        </mxCell>
        <mxCell id="beast_claws" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#ffffff,#111111);strokeColor=#6c8ebf;fontSize=12;fontColor=light-dark(#111111,#ffffff);" value="&lt;b&gt;Earthstride&lt;/b&gt;:&lt;div&gt;Sand, rubble, hills, and mountain terrain cost only 1 Move. Mihata may enter Mountain tiles normally inaccessible to infantry. Stone terrain (Mountain, Cave, Ruins, Stone Floor) grants +3 Atk and +4 Def.&lt;/div&gt;" vertex="1">
          <mxGeometry height="125" width="300" x="1117" y="557.5" as="geometry" />
        </mxCell>
        <mxCell id="beast_hide" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#ffffff,#111111);strokeColor=#6c8ebf;fontSize=12;fontColor=light-dark(#111111,#ffffff);" value="&lt;b&gt;Stonebound Pounce&lt;/b&gt;:&lt;div&gt;Before attacking, leap up to 3 tiles to a passable tile, crossing units and rough terrain. If the destination is Stone terrain, range becomes 4. The next melee attack this turn gains +3 damage.&lt;/div&gt;" vertex="1">
          <mxGeometry height="125" width="320" x="1457" y="557.5" as="geometry" />
        </mxCell>
        <mxCell id="beast_pounce" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#ffffff,#111111);strokeColor=#6c8ebf;fontSize=12;fontColor=light-dark(#111111,#ffffff);" value="&lt;b&gt;Terra Claws&lt;/b&gt;:&lt;div&gt;Mihata can't use weapons and instead attacks with claws.&lt;/div&gt;&lt;div&gt;Claws use strength + magic/4.&lt;/div&gt;&lt;div&gt;Has a chance to stun depending on Mihatas defense.&lt;/div&gt;" vertex="1">
          <mxGeometry height="125" width="320" x="750" y="557.5" as="geometry" />
        </mxCell>
        <mxCell id="gold_class" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#dae8fc,#15283d);strokeColor=#6c8ebf;fontSize=16;fontStyle=1;fontColor=light-dark(#111111,#ffffff);" value="Gold Form" vertex="1">
          <mxGeometry height="70" width="170" x="430" y="960" as="geometry" />
        </mxCell>
        <mxCell id="gold_physical" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#ffffff,#161616);strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacing=8;fontColor=light-dark(#111111,#ffffff);" value="&lt;b&gt;Physical state&lt;/b&gt;&lt;div&gt;Approx. 3 m tall / ~1300 kg. Her strength fully compensates for the mass, so Move is unchanged. The weight is everyone else's problem.&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="285" x="430" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="gold_benefit" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#d5e8d4,#17331d);strokeColor=#82b366;fontSize=12;fontColor=light-dark(#111111,#ffffff);" value="&lt;b&gt;Benefit — Gilded Colossus&lt;/b&gt;&lt;div&gt;+8 Def, +5 Res, normal Move, immune to push/pull.&lt;/div&gt;" vertex="1">
          <mxGeometry height="85" width="415" x="755" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="gold_drawback" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#f8cecc,#3b1718);strokeColor=#b85450;fontSize=12;fontColor=light-dark(#111111,#ffffff);" value="&lt;b&gt;Drawback — Auric Appetite&lt;/b&gt;&lt;div&gt;Costs 10 gold to transform.&lt;/div&gt;&lt;div&gt;Also an upkeep cost of 5 gold each turn.&lt;/div&gt;" vertex="1">
          <mxGeometry height="85" width="460" x="1200" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="gold_crush" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#ffffff,#111111);strokeColor=#6c8ebf;fontSize=12;fontColor=light-dark(#111111,#ffffff);" value="&lt;b&gt;Gold Lance — Cost 2 Gold&lt;/b&gt;:&lt;div&gt;Range 1–3. Conjure a massive golden lance. +5 damage and ignores 30% of the target's Def. If used at range 1, also push the target 1 tile.&lt;/div&gt;" vertex="1">
          <mxGeometry height="125" width="310" x="755" y="920" as="geometry" />
        </mxCell>
        <mxCell id="gold_well" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#ffffff,#111111);strokeColor=#6c8ebf;fontSize=12;fontColor=light-dark(#111111,#ffffff);" value="&lt;b&gt;Drowning Greed — Cost 3 Gold&lt;/b&gt;:&lt;div&gt;Melee range.&lt;/div&gt;&lt;div&gt;Mihata forces gold into a targets mouth to deal damage.&lt;br&gt;Deals massive damage but Mihata and enemy is locked for 2 turns to complete this.&lt;br&gt;&lt;br&gt;Attack Power = Magic + Strength vs enemy defense.&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="125" width="320" x="1520" y="920" as="geometry" />
        </mxCell>
        <mxCell id="qrUlXLS8Ja-MGCBHV1_3-15" edge="1" parent="1" source="gold_guard" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="gold_statue_state">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gold_guard" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#ffffff,#111111);strokeColor=#6c8ebf;fontSize=12;fontColor=light-dark(#111111,#ffffff);" value="&lt;b&gt;Gild Ally — Cost 5 Gold&lt;/b&gt;:&lt;div&gt;Range 1. Turn a friendly unit into living gold While active: +5 Atk, +6 Def, +4 Res, immune to push/pull, Move unchanged.&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="360" x="1880" y="920" as="geometry" />
        </mxCell>
        <mxCell id="gold_collapse" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#ffffff,#111111);strokeColor=#6c8ebf;fontSize=12;fontColor=light-dark(#111111,#ffffff);" value="&lt;b&gt;Gold Nova — Cost 6 Gold&lt;/b&gt;:&lt;br&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(17, 17, 17), rgb(255, 255, 255));&quot;&gt;Target a 3×3 area within 4 tiles&lt;/span&gt;. Enemies take magical damage.&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(17, 17, 17), rgb(255, 255, 255));&quot;&gt;Uses Miha's magic to define attack power.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(17, 17, 17), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(17, 17, 17), rgb(255, 255, 255));&quot;&gt;Gilded allies in the nova instead are healed.&lt;br&gt;Not gilded allies are gilded if hit.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="125" width="360" x="1117" y="920" as="geometry" />
        </mxCell>
        <mxCell id="beast_stonehide" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#ffffff,#111111);strokeColor=#6c8ebf;fontSize=12;fontColor=light-dark(#111111,#ffffff);" value="&lt;b&gt;Stonehide&lt;/b&gt;:&lt;div&gt;Gain +7 Def and +3 Res until next turn. On Stone terrain this becomes +10 Def / +5 Res. While active, Mihata loses 1 Move and cannot use Stonebound Pounce.&lt;/div&gt;" vertex="1">
          <mxGeometry height="125" width="320" x="1817" y="557.5" as="geometry" />
        </mxCell>
        <mxCell id="gold_statue_state" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#f8cecc,#3b1718);strokeColor=#b85450;fontSize=12;fontColor=light-dark(#111111,#ffffff);" value="&lt;b&gt;Inert Statue&lt;/b&gt;&lt;div&gt;All gilded Allies will stay stuck and cant move as long as Mihata is not in her gold form.&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="360" x="1880" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="qrUlXLS8Ja-MGCBHV1_3-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a20025;strokeColor=#6F0000;fontSize=12;fontColor=#ffffff;" value="&lt;b&gt;Info&lt;/b&gt;:&lt;div&gt;Each form has its own skill point and progression.&lt;br&gt;The player can select form skills in which ever order they want unless otherwise stated.&lt;/div&gt;" vertex="1">
          <mxGeometry height="125" width="300" x="40" y="520" as="geometry" />
        </mxCell>
        <mxCell id="qrUlXLS8Ja-MGCBHV1_3-13" edge="1" parent="1" source="qrUlXLS8Ja-MGCBHV1_3-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="beast_benefit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qrUlXLS8Ja-MGCBHV1_3-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#a20025;strokeColor=#6F0000;fontSize=12;fontColor=#ffffff;" value="&lt;b&gt;Permanent Passive&lt;/b&gt;:&lt;div&gt;This is active no matter which form Mihata is in.&lt;/div&gt;" vertex="1">
          <mxGeometry height="85" width="180" x="440" y="720" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="mihata-v2-17" name="Mihata Progression V2">
    <mxGraphModel dx="2500" dy="1550" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2550" pageHeight="1850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="mv2_bg" value="Mihata — Unique Progression V2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#f5f5f5,#171717);strokeColor=#777777;fontSize=22;fontStyle=1;align=left;verticalAlign=top;spacingTop=10;spacingLeft=14;fontColor=light-dark(#111111,#ffffff);" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="2390" height="1640" as="geometry" />
        </mxCell>
        <mxCell id="mv2_note" value="&lt;b&gt;Design:&lt;/b&gt; Mihata does not use a normal class tree. Her martial growth is capped by poor magical throughput, so she relies on alchemy and transformations. Potions are primarily party tools; forms are powerful self-loadouts with explicit drawbacks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#fff2cc,#3b330d);strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=middle;spacing=8;fontColor=light-dark(#111111,#ffffff);" vertex="1" parent="1">
          <mxGeometry x="90" y="90" width="2280" height="85" as="geometry" />
        </mxCell>
        <mxCell id="mv2_core_hdr" value="Core" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#ffffff,#1d1d1d);strokeColor=#666666;fontSize=17;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;fontColor=light-dark(#111111,#ffffff);" vertex="1" parent="1">
          <mxGeometry x="100" y="210" width="2230" height="170" as="geometry" />
        </mxCell>
        <mxCell id="mv2_mihata" value="Mihata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="260" width="120" height="65" as="geometry" />
        </mxCell>
        <mxCell id="mv2_sword" value="&lt;b&gt;Sword &amp; Shield&lt;/b&gt;:&lt;div&gt;Reliable martial baseline. Cannot progress into higher Kharazad body-channeling tiers because of low magical throughput.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="245" width="330" height="95" as="geometry" />
        </mxCell>
        <mxCell id="mv2_synth" value="&lt;b&gt;Synthesis&lt;/b&gt;:&lt;div&gt;Prepare potions before battle. Potions can be handed to allies and used without Mihata being nearby.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="750" y="245" width="330" height="95" as="geometry" />
        </mxCell>
        <mxCell id="mv2_control" value="&lt;b&gt;Transformation Control&lt;/b&gt;:&lt;div&gt;Switch into an unlocked form. Forms replace normal equipment and most potion use until Mihata reverts.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1160" y="245" width="330" height="95" as="geometry" />
        </mxCell>
        <mxCell id="mv2_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#d6b656;strokeWidth=3;" edge="1" parent="1" source="mv2_mihata" target="mv2_sword">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mv2_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#9673a6;strokeWidth=3;" edge="1" parent="1" source="mv2_sword" target="mv2_synth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mv2_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#9673a6;strokeWidth=3;" edge="1" parent="1" source="mv2_synth" target="mv2_control">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mv2_potion_hdr" value="Alchemy — Party Potions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#ffffff,#1d1d1d);strokeColor=#666666;fontSize=17;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;fontColor=light-dark(#111111,#ffffff);" vertex="1" parent="1">
          <mxGeometry x="100" y="430" width="2230" height="430" as="geometry" />
        </mxCell>
        <mxCell id="mv2_p1" value="&lt;b&gt;Mending Draught&lt;/b&gt;:&lt;div&gt;Restore 35% max HP. Basic, reliable healing dose.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#e1d5e7,#2c2034);strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacing=7;fontColor=light-dark(#111111,#ffffff);" vertex="1" parent="1">
          <mxGeometry x="160" y="500" width="290" height="130" as="geometry" />
        </mxCell>
        <mxCell id="mv2_p2" value="&lt;b&gt;Stonehide Tonic&lt;/b&gt;:&lt;div&gt;+5 Def/+3 Res for 2 turns; -1 Move while active.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#e1d5e7,#2c2034);strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacing=7;fontColor=light-dark(#111111,#ffffff);" vertex="1" parent="1">
          <mxGeometry x="500" y="500" width="290" height="130" as="geometry" />
        </mxCell>
        <mxCell id="mv2_p3" value="&lt;b&gt;Redline Tonic&lt;/b&gt;:&lt;div&gt;+2 Move and +4 Atk for 1 turn; next turn -2 Move/-4 Def.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#e1d5e7,#2c2034);strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacing=7;fontColor=light-dark(#111111,#ffffff);" vertex="1" parent="1">
          <mxGeometry x="840" y="500" width="290" height="130" as="geometry" />
        </mxCell>
        <mxCell id="mv2_p4" value="&lt;b&gt;Purity Serum&lt;/b&gt;:&lt;div&gt;Remove poison, bleed, burn, curse or mutation-type debuff.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#e1d5e7,#2c2034);strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacing=7;fontColor=light-dark(#111111,#ffffff);" vertex="1" parent="1">
          <mxGeometry x="1180" y="500" width="290" height="130" as="geometry" />
        </mxCell>
        <mxCell id="mv2_p5" value="&lt;b&gt;Adaptive Tonic&lt;/b&gt;:&lt;div&gt;User chooses +4 Def, +4 Res or +15 Avoid for 2 turns.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#e1d5e7,#2c2034);strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacing=7;fontColor=light-dark(#111111,#ffffff);" vertex="1" parent="1">
          <mxGeometry x="1520" y="500" width="290" height="130" as="geometry" />
        </mxCell>
        <mxCell id="mv2_p6" value="&lt;b&gt;Phoenix Dose&lt;/b&gt;:&lt;div&gt;Late recipe. Once per map, if user would fall to 0 HP this turn, remain at 1 HP and heal 20% after combat.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#e1d5e7,#2c2034);strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacing=7;fontColor=light-dark(#111111,#ffffff);" vertex="1" parent="1">
          <mxGeometry x="1860" y="500" width="290" height="130" as="geometry" />
        </mxCell>
        <mxCell id="mv2_batch" value="&lt;b&gt;Improved Synthesis&lt;/b&gt;:&lt;div&gt;Late alchemy upgrade: prepare 2 extra potion charges per map and allies may use Mihata's potions from shared inventory.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#e1d5e7,#2c2034);strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacing=7;fontColor=light-dark(#111111,#ffffff);" vertex="1" parent="1">
          <mxGeometry x="840" y="680" width="650" height="110" as="geometry" />
        </mxCell>
        <mxCell id="mv2_forms_hdr" value="Transformations" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#ffffff,#1d1d1d);strokeColor=#666666;fontSize=17;fontStyle=1;align=center;verticalAlign=top;spacingTop=8;fontColor=light-dark(#111111,#ffffff);" vertex="1" parent="1">
          <mxGeometry x="100" y="910" width="2230" height="650" as="geometry" />
        </mxCell>
        <mxCell id="mv2_beast" value="&lt;b style='font-size:16px'&gt;Beast Form&lt;/b&gt;&lt;div style='margin-top:5px'&gt;&lt;b&gt;Role:&lt;/b&gt; terrain predator / melee sustain&lt;br/&gt;&lt;b&gt;Core:&lt;/b&gt; regeneration; sand, rubble, hills and mountains cost 1 Move; Stone terrain buffs defenses.&lt;br/&gt;&lt;b&gt;Signature:&lt;/b&gt; Stonebound Pounce, Terra Claws, Rampart Slam creates a 3-tile stone wall.&lt;br/&gt;&lt;b&gt;Drawback:&lt;/b&gt; no normal weapons, items or ranged attacks; weaker magic defense.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#ffffff,#151515);strokeColor=#777777;fontSize=12;align=left;verticalAlign=top;spacing=8;fontColor=light-dark(#111111,#ffffff);strokeColor=#82b366;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="150" y="1010" width="390" height="220" as="geometry" />
        </mxCell>
        <mxCell id="mv2_gold" value="&lt;b style='font-size:16px'&gt;Gold Form&lt;/b&gt;&lt;div style='margin-top:5px'&gt;&lt;b&gt;Role:&lt;/b&gt; expensive juggernaut / gravity control&lt;br/&gt;&lt;b&gt;Core:&lt;/b&gt; ~3 m, ~1300 kg, normal Move, immune to push/pull; transformation and skills consume Gold.&lt;br/&gt;&lt;b&gt;Signature:&lt;/b&gt; Gold Lance, Gravity Well, Gold Nova, Gild Ally.&lt;br/&gt;&lt;b&gt;Drawback:&lt;/b&gt; gilded allies become inert statues when Mihata leaves Gold Form and cannot be healed until a late upgrade.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#ffffff,#151515);strokeColor=#777777;fontSize=12;align=left;verticalAlign=top;spacing=8;fontColor=light-dark(#111111,#ffffff);strokeColor=#d6b656;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="580" y="1010" width="390" height="220" as="geometry" />
        </mxCell>
        <mxCell id="mv2_ice" value="&lt;b style='font-size:16px'&gt;Ice Form&lt;/b&gt;&lt;div style='margin-top:5px'&gt;&lt;b&gt;Role:&lt;/b&gt; control / mobility denial&lt;br/&gt;&lt;b&gt;Core:&lt;/b&gt; create Ice terrain; Mihata slides across her own Ice without movement cost once per turn.&lt;br/&gt;&lt;b&gt;Signature:&lt;/b&gt; Frost Lance, Flash Freeze, Ice Ramp creates a traversable 2-tile bridge/ramp.&lt;br/&gt;&lt;b&gt;Drawback:&lt;/b&gt; fire damage is amplified; taking heavy fire damage removes nearby Ice terrain.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#ffffff,#151515);strokeColor=#777777;fontSize=12;align=left;verticalAlign=top;spacing=8;fontColor=light-dark(#111111,#ffffff);strokeColor=#66c7ff;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1010" y="1010" width="390" height="220" as="geometry" />
        </mxCell>
        <mxCell id="mv2_dryad" value="&lt;b style='font-size:16px'&gt;Dryad Form&lt;/b&gt;&lt;div style='margin-top:5px'&gt;&lt;b&gt;Role:&lt;/b&gt; support / terrain growth&lt;br/&gt;&lt;b&gt;Core:&lt;/b&gt; heal on natural terrain; create brush/vines; allies on grown terrain gain small regeneration.&lt;br/&gt;&lt;b&gt;Signature:&lt;/b&gt; Rootbind, Living Cover, Bloom transfers healing to nearby allies.&lt;br/&gt;&lt;b&gt;Drawback:&lt;/b&gt; slower on barren/constructed terrain and vulnerable to fire/cleansing effects.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#ffffff,#151515);strokeColor=#777777;fontSize=12;align=left;verticalAlign=top;spacing=8;fontColor=light-dark(#111111,#ffffff);strokeColor=#5fbf5f;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1010" width="390" height="220" as="geometry" />
        </mxCell>
        <mxCell id="mv2_blood" value="&lt;b style='font-size:16px'&gt;Blood Warrior Form&lt;/b&gt;&lt;div style='margin-top:5px'&gt;&lt;b&gt;Role:&lt;/b&gt; endgame apex form&lt;br/&gt;&lt;b&gt;Core:&lt;/b&gt; converts HP loss into escalating strength, speed and regeneration; can spend HP instead of most resource costs.&lt;br/&gt;&lt;b&gt;Signature:&lt;/b&gt; Bloodstep, Crimson Cleave, Heartbreak ignores death once and continues at 1 HP.&lt;br/&gt;&lt;b&gt;Drawback:&lt;/b&gt; cannot receive normal healing while transformed; below 20% HP the form becomes increasingly difficult to control.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#ffffff,#151515);strokeColor=#777777;fontSize=12;align=left;verticalAlign=top;spacing=8;fontColor=light-dark(#111111,#ffffff);strokeColor=#d13f3f;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="795" y="1290" width="740" height="220" as="geometry" />
        </mxCell>
        <mxCell id="mv2_to_beast" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="mv2_control" target="mv2_beast">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mv2_to_gold" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1" source="mv2_control" target="mv2_gold">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mv2_to_ice" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#66c7ff;strokeWidth=2;" edge="1" parent="1" source="mv2_control" target="mv2_ice">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mv2_to_dryad" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#5fbf5f;strokeWidth=2;" edge="1" parent="1" source="mv2_control" target="mv2_dryad">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mv2_to_blood" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#d13f3f;strokeWidth=3;" edge="1" parent="1" source="mv2_control" target="mv2_blood">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="vey17" name="Veyrhold Orders"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="3577" math="0" shadow="0" background="#f7f4ee"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="vey17_panel_1" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1660" height="12" as="geometry" /></mxCell><mxCell id="vey17_text_2" value="VEYRHOLD / DISCIPLINE MADE MATERIAL" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=32;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="35" width="1580" height="49.2" as="geometry" /></mxCell><mxCell id="vey17_text_3" value="Sacred engineering, prepared firepower and maintained wards. Build a precise shooter, a position worth holding, or a walking sanctuary." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="92.2" width="1580" height="27.6" as="geometry" /></mxCell><mxCell id="vey17_panel_4" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e0e8f0;strokeColor=#e0e8f0;" vertex="1" parent="1"><mxGeometry x="40" y="131.8" width="1580" height="102.8" as="geometry" /></mxCell><mxCell id="vey17_text_5" value="Build direction — proposal for review" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="143.8" width="1544" height="27.6" as="geometry" /></mxCell><mxCell id="vey17_text_6" value="Follow one connected promotion path. Each class contributes the two skills printed on its card; keep learned ancestor skills, with explicit upgrades replacing earlier versions. No attribute gates are proposed. Six separate discipline choices allow personal&#10;variation; choose one per numbered column, two per tier. Unlock levels, point costs, respec rules and exact balance still need confirmation. This proposal does not change the implemented class-selection system." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="175.8" width="1544" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="vey17_text_7" value="BALLISTICS ORDERS" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=24;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="274.6" width="1580" height="38.400000000000006" as="geometry" /></mxCell><mxCell id="vey17_text_8" value="The weapon rewards discipline: establish a firing position or breach the room." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=15;fontColor=#202b30;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="316.0" width="1580" height="26.25" as="geometry" /></mxCell><mxCell id="vey17_text_9" value="DISCIPLINE" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="357.25" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="vey17_text_10" value="SPECIALIZATION" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="357.25" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="vey17_text_11" value="MASTERY" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="357.25" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="vey17_panel_12" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="600" y="389.25" width="440" height="291.55" as="geometry" /></mxCell><mxCell id="vey17_panel_13" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="600" y="389.25" width="5" height="291.55" as="geometry" /></mxCell><mxCell id="vey17_text_14" value="Marksman" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="vey17_panel_12"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="vey17_text_15" value="Select a threat, stay still and make your shot count." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="vey17_panel_12"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_16" value="Spotter Round [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_12"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_17" value="Firearm attack with 25% less strike damage. A damaging opening&#10;hit marks the enemy until your next activation; allied attacks gain&#10;+15 Hit against it." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_12"><mxGeometry x="18" y="120.15" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="vey17_text_18" value="Long Sight [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_12"><mxGeometry x="18" y="189.85000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_19" value="If you spent no Move this activation, your initiated firearm&#10;combat gains +1 maximum range. Minimum range is unchanged." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_12"><mxGeometry x="18" y="221.75000000000003" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="vey17_panel_20" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1140" y="389.25" width="440" height="291.55" as="geometry" /></mxCell><mxCell id="vey17_panel_21" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="1140" y="389.25" width="5" height="291.55" as="geometry" /></mxCell><mxCell id="vey17_text_22" value="Deadeye" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="vey17_panel_20"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="vey17_text_23" value="A precise shot changes what the enemy is allowed to do next." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="vey17_panel_20"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_24" value="Called Shot [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_20"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_25" value="Firearm attack at normal range. On a damaging opening hit&#10;choose Arm (-4 attack power) or Leg (Pinned), lasting until your&#10;next activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_20"><mxGeometry x="18" y="120.15" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="vey17_text_26" value="Patient Execution [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_20"><mxGeometry x="18" y="189.85000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_27" value="Your stationary opening firearm strike ignores 30% Def against a&#10;Marked target. Physical damage only." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_20"><mxGeometry x="18" y="221.75000000000003" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="vey17_edge_28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#3c597a;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="vey17_panel_12" target="vey17_panel_20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="vey17_panel_29" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="600" y="704.8" width="440" height="291.55" as="geometry" /></mxCell><mxCell id="vey17_panel_30" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="600" y="704.8" width="5" height="291.55" as="geometry" /></mxCell><mxCell id="vey17_text_31" value="Breacher" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="vey17_panel_29"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="vey17_text_32" value="Walk into danger with a weapon made to clear it." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="vey17_panel_29"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_33" value="Close Blast [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_29"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_34" value="Make a range-1 firearm attack. A damaging opening hit pushes&#10;the target 1 tile away after combat if legal. This skill permits range&#10;1 for that exchange." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_29"><mxGeometry x="18" y="120.15" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="vey17_text_35" value="Entry Armor [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_29"><mxGeometry x="18" y="189.85000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_36" value="During your initiated range-1 firearm combat, take 25% less&#10;counter and follow-up damage." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_29"><mxGeometry x="18" y="221.75000000000003" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="vey17_panel_37" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1140" y="704.8" width="440" height="310.45000000000005" as="geometry" /></mxCell><mxCell id="vey17_panel_38" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="1140" y="704.8" width="5" height="310.45000000000005" as="geometry" /></mxCell><mxCell id="vey17_text_39" value="Ironstorm" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="vey17_panel_37"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="vey17_text_40" value="Own the cramped space without needing a second full turn." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="vey17_panel_37"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_41" value="Room Clear [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_37"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_42" value="Make a range-1 firearm attack. After combat, strike one other&#10;enemy adjacent to you for 50% ordinary damage; no crit, counter&#10;or skill triggers." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_37"><mxGeometry x="18" y="120.15" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="vey17_text_43" value="Repelling Fire [Wait replacement]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_37"><mxGeometry x="18" y="189.85000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_44" value="Until your next activation, fire at the first enemy entering an&#10;adjacent tile: 60% ordinary damage. A damaging hit stops&#10;movement. No crit, counter or follow-up." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_37"><mxGeometry x="18" y="221.75000000000003" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="vey17_edge_45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#3c597a;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="vey17_panel_29" target="vey17_panel_37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="vey17_panel_46" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="60" y="565.925" width="440" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="vey17_panel_47" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="60" y="565.925" width="5" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="vey17_text_48" value="Gunner" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="vey17_panel_46"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="vey17_text_49" value="A composed shooter who makes distance count." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="vey17_panel_46"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_50" value="Set Aim [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_46"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_51" value="Make a firearm attack at normal range. If you spent no Move this&#10;activation, opening strike gains +20 Hit." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_46"><mxGeometry x="18" y="120.15" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="vey17_text_52" value="Controlled Withdrawal [After combat; 1/activation]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_46"><mxGeometry x="18" y="170.95000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_53" value="After initiating firearm combat, move 1 legal tile. Does not reload&#10;or grant another action." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_46"><mxGeometry x="18" y="202.85000000000002" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="vey17_edge_54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#3c597a;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="vey17_panel_46" target="vey17_panel_12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="vey17_edge_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#3c597a;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="vey17_panel_46" target="vey17_panel_29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="vey17_text_56" value="ENGINEERING GUILDS" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=24;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1083.25" width="1580" height="38.400000000000006" as="geometry" /></mxCell><mxCell id="vey17_text_57" value="Bring a prepared machine and make the battlefield function on your terms." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=15;fontColor=#202b30;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1124.65" width="1580" height="26.25" as="geometry" /></mxCell><mxCell id="vey17_text_58" value="DISCIPLINE" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1165.9" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="vey17_text_59" value="SPECIALIZATION" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="1165.9" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="vey17_text_60" value="MASTERY" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="1165.9" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="vey17_panel_61" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="600" y="1197.9" width="440" height="291.55" as="geometry" /></mxCell><mxCell id="vey17_panel_62" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="600" y="1197.9" width="5" height="291.55" as="geometry" /></mxCell><mxCell id="vey17_text_63" value="Constructor" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="vey17_panel_61"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="vey17_text_64" value="Turn spare ground into a defended position." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="vey17_panel_61"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_65" value="Sentry Turret [Action; 1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_61"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_66" value="Deploy a turret on a free adjacent tile: 15 HP, Def/Res 0, no&#10;Move. Next round onward, choose one target at range 2-3 for&#10;one 80-Hit physical shot of power 6 + floor(Skill/2)." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_61"><mxGeometry x="18" y="120.15" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="vey17_text_67" value="Service Position [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_61"><mxGeometry x="18" y="189.85000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_68" value="Your Field Repair also grants the repaired device +3 Def and +3&#10;Res until your next activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_61"><mxGeometry x="18" y="221.75000000000003" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="vey17_panel_69" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1140" y="1197.9" width="440" height="291.55" as="geometry" /></mxCell><mxCell id="vey17_panel_70" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="1140" y="1197.9" width="5" height="291.55" as="geometry" /></mxCell><mxCell id="vey17_text_71" value="Siegewright" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="vey17_panel_69"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="vey17_text_72" value="Build a position worth fighting to hold." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="vey17_panel_69"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_73" value="Fortification [Upgrade]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_69"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_74" value="Your barricades have 30 HP; your turret has 25 HP. Turret and&#10;barricade limits remain separate; no additional turret is granted." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_69"><mxGeometry x="18" y="120.15" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="vey17_text_75" value="Overclock [Action; 1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_69"><mxGeometry x="18" y="170.95000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_76" value="Your turret within 4 tiles fires one immediate normal shot at a&#10;legal target. It cannot fire in the next player phase. May be used&#10;on its deployment turn." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_69"><mxGeometry x="18" y="202.85000000000002" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="vey17_edge_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#3c597a;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="vey17_panel_61" target="vey17_panel_69"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="vey17_panel_78" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="600" y="1513.45" width="440" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="vey17_panel_79" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="600" y="1513.45" width="5" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="vey17_text_80" value="Augmentor" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="vey17_panel_78"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="vey17_text_81" value="Wear the machine. Mobility and stability are choices you make." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="vey17_panel_78"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_82" value="Servo Harness [Mode; 1/activation]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_78"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_83" value="At activation start choose Stride (+1 Move, -2 Def) or Brace (+3&#10;Def, -1 Move, minimum 1). Lasts until your next activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_78"><mxGeometry x="18" y="120.15" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="vey17_text_84" value="Utility Arm [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_78"><mxGeometry x="18" y="170.95000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_85" value="Field Repair reaches 2 tiles. After repairing, move 1 legal tile; gain&#10;no further action." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_78"><mxGeometry x="18" y="202.85000000000002" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="vey17_panel_86" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1140" y="1513.45" width="440" height="329.34999999999997" as="geometry" /></mxCell><mxCell id="vey17_panel_87" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="1140" y="1513.45" width="5" height="329.34999999999997" as="geometry" /></mxCell><mxCell id="vey17_text_88" value="Exosaint" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="vey17_panel_86"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="vey17_text_89" value="A sacred frame turns its pilot into the formation's moving&#10;anchor." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="vey17_panel_86"><mxGeometry x="18" y="56.35" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="vey17_text_90" value="Consecrated Frame [Action; 1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_86"><mxGeometry x="18" y="107.15" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_91" value="For 3 of your activations gain +5 Def/+3 Res and push/pull&#10;immunity. Ends Servo Harness and prevents choosing its modes&#10;while active." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_86"><mxGeometry x="18" y="139.05" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="vey17_text_92" value="Integrated Cannon [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_86"><mxGeometry x="18" y="208.75" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_93" value="While Frame is active, make one range-2-3 physical strike: power&#10;8 + floor(Skill/2), Hit 85. No crit or speed follow-up; a legal enemy&#10;counter still resolves." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_86"><mxGeometry x="18" y="240.65" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="vey17_edge_94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#3c597a;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="vey17_panel_78" target="vey17_panel_86"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="vey17_panel_95" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="60" y="1374.575" width="440" height="291.55" as="geometry" /></mxCell><mxCell id="vey17_panel_96" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="60" y="1374.575" width="5" height="291.55" as="geometry" /></mxCell><mxCell id="vey17_text_97" value="Mechanic" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="vey17_panel_95"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="vey17_text_98" value="A useful machine is one you can keep operating under pressure." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="vey17_panel_95"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_99" value="Field Repair [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_95"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_100" value="Restore 10 + floor(Skill/2) HP to an adjacent friendly construct or&#10;device. Cannot heal living units." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_95"><mxGeometry x="18" y="120.15" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="vey17_text_101" value="Barricade [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_95"><mxGeometry x="18" y="170.95000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_102" value="Place a 20-HP, Def/Res 0 barricade on a visible free adjacent tile.&#10;Blocks walking but not line of sight; anyone may attack it.&#10;Maximum 1 of your barricades." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_95"><mxGeometry x="18" y="202.85000000000002" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="vey17_edge_103" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#3c597a;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="vey17_panel_95" target="vey17_panel_61"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="vey17_edge_104" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#3c597a;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="vey17_panel_95" target="vey17_panel_78"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="vey17_text_105" value="SANCTUM WARDENS" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=24;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1910.8" width="1580" height="38.400000000000006" as="geometry" /></mxCell><mxCell id="vey17_text_106" value="Ritual precision made into protective engineering. Break hostile magic without erasing your allies' choices." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=15;fontColor=#202b30;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1952.2" width="1580" height="26.25" as="geometry" /></mxCell><mxCell id="vey17_text_107" value="DISCIPLINE" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1993.45" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="vey17_text_108" value="SPECIALIZATION" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="1993.45" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="vey17_text_109" value="MASTERY" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="1993.45" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="vey17_panel_110" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="600" y="2025.45" width="440" height="291.55" as="geometry" /></mxCell><mxCell id="vey17_panel_111" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="600" y="2025.45" width="5" height="291.55" as="geometry" /></mxCell><mxCell id="vey17_text_112" value="Inquisitor" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="vey17_panel_110"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="vey17_text_113" value="Expose the spellcaster, then make a disciplined arrest by force." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="vey17_panel_110"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_114" value="Sanction [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_110"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_115" value="Mark one visible enemy within 3 tiles until your next activation.&#10;Your opening weapon strike against it gains +4 power if it has a&#10;magical weapon or positive magical status." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_110"><mxGeometry x="18" y="120.15" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="vey17_text_116" value="Disruptor Round [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_110"><mxGeometry x="18" y="189.85000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_117" value="Make a firearm attack. On a damaging opening hit, suppress one&#10;chosen positive magical status until your next activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_110"><mxGeometry x="18" y="221.75000000000003" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="vey17_panel_118" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1140" y="2025.45" width="440" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="vey17_panel_119" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="1140" y="2025.45" width="5" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="vey17_text_120" value="Null Knight" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="vey17_panel_118"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="vey17_text_121" value="Close the distance until hostile magic loses its certainty." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="vey17_panel_118"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_122" value="Silence Warrant [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_118"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_123" value="One visible enemy within 2 tiles cannot use healing or buff skills&#10;until your next activation. It can still move, attack and use items." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_118"><mxGeometry x="18" y="120.15" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="vey17_text_124" value="Purity Guard [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_118"><mxGeometry x="18" y="170.95000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_125" value="You and adjacent allies gain +4 Res. Multiple copies do not stack;&#10;does not remove friendly enhancements." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_118"><mxGeometry x="18" y="202.85000000000002" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="vey17_edge_126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#3c597a;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="vey17_panel_110" target="vey17_panel_118"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="vey17_panel_127" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="600" y="2341.0" width="440" height="291.55" as="geometry" /></mxCell><mxCell id="vey17_panel_128" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="600" y="2341.0" width="5" height="291.55" as="geometry" /></mxCell><mxCell id="vey17_text_129" value="Reliquary Guard" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="vey17_panel_127"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="vey17_text_130" value="Carry the ward to the place your allies need to stand." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="vey17_panel_127"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_131" value="Ward Beacon [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_127"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_132" value="Place a 15-HP, Def/Res 0 beacon on a free adjacent tile. Allies&#10;adjacent to it take 25% less magical strike damage. Maximum 1&#10;beacon; lasts 3 rounds." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_127"><mxGeometry x="18" y="120.15" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="vey17_text_133" value="Recover Relic [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_127"><mxGeometry x="18" y="189.85000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_134" value="Remove your adjacent beacon and restore 1 Ward Beacon use,&#10;capped at 2. Cannot recover a destroyed beacon." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_127"><mxGeometry x="18" y="221.75000000000003" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="vey17_panel_135" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1140" y="2341.0" width="440" height="310.45000000000005" as="geometry" /></mxCell><mxCell id="vey17_panel_136" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="1140" y="2341.0" width="5" height="310.45000000000005" as="geometry" /></mxCell><mxCell id="vey17_text_137" value="Archwarden" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="vey17_panel_135"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="vey17_text_138" value="Turn a small sanctuary into a decisive defensive commitment." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="vey17_panel_135"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_139" value="Cathedral Field [Action; 1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_135"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_140" value="Until your next activation, your beacon within 4 tiles protects&#10;allies within 2 tiles for 40% less magical strike damage, replacing&#10;its normal reduction." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_135"><mxGeometry x="18" y="120.15" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="vey17_text_141" value="Judgement Pulse [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_135"><mxGeometry x="18" y="189.85000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_142" value="Choose an enemy within 2 tiles of your beacon, with the beacon&#10;within 4 of you. Make one magical strike of power Mag + 6, Hit&#10;90. No crit, counter or follow-up." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_135"><mxGeometry x="18" y="221.75000000000003" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="vey17_edge_143" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#3c597a;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="vey17_panel_127" target="vey17_panel_135"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="vey17_panel_144" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="60" y="2192.6749999999997" width="440" height="291.55" as="geometry" /></mxCell><mxCell id="vey17_panel_145" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="60" y="2192.6749999999997" width="5" height="291.55" as="geometry" /></mxCell><mxCell id="vey17_text_146" value="Warden" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="vey17_panel_144"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="vey17_text_147" value="Stand where a spell would otherwise break the line." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="vey17_panel_144"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_148" value="Null Plate [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_144"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_149" value="The first magical strike that damages you each round deals 25%&#10;less damage." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_144"><mxGeometry x="18" y="120.15" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="vey17_text_150" value="Seal [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="vey17_panel_144"><mxGeometry x="18" y="170.95000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="vey17_text_151" value="Suppress one chosen positive magical status on a visible enemy&#10;within 3 tiles until your next activation. Its original duration keeps&#10;ticking." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="vey17_panel_144"><mxGeometry x="18" y="202.85000000000002" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="vey17_edge_152" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#3c597a;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="vey17_panel_144" target="vey17_panel_110"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="vey17_edge_153" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#3c597a;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="vey17_panel_144" target="vey17_panel_127"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="vey17_text_154" value="MECHANICAL CONTRACT / FIRST-PASS PROPOSAL" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=20;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="2715.45" width="1580" height="33.0" as="geometry" /></mxCell><mxCell id="vey17_panel_155" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e0e8f0;strokeColor=#e0e8f0;" vertex="1" parent="1"><mxGeometry x="40" y="2763.45" width="1580" height="140.6" as="geometry" /></mxCell><mxCell id="vey17_text_156" value="Veyrhold rulings" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="2775.45" width="1544" height="27.6" as="geometry" /></mxCell><mxCell id="vey17_text_157" value="Devices are new stationary units: targetable, nonliving, occupy their tile, never counter or follow up, yield no XP/corpse, and vanish at map end. A turret lasts 3 player phases after deployment; it gets one controller-chosen shot at the start of each of&#10;those phases. No target means no shot. Turret attacks use physical power vs Def and the listed Hit minus target Avoid; no block without a shield, no crit/counter/follow-up. Owner Skill is captured when deployed. Wards are magical statuses; equipment&#10;modes, firearm marks and physical tools are not. Seal suppresses a timed magical status, not a class, form or equipment item. Buff durations keep ticking while suppressed. Firearms use existing weapon stats; this pass requires no magazine/reload&#10;economy. Targeted skills require visible targets and legal range." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="2807.45" width="1544" height="81.60000000000001" as="geometry" /></mxCell><mxCell id="vey17_panel_158" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e0e8f0;strokeColor=#e0e8f0;" vertex="1" parent="1"><mxGeometry x="40" y="2924.0499999999997" width="1580" height="140.6" as="geometry" /></mxCell><mxCell id="vey17_text_159" value="Action and timing" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="2936.0499999999997" width="1544" height="27.6" as="geometry" /></mxCell><mxCell id="vey17_text_160" value="First-pass design proposal, not an implementation claim. Numbers are starting balance values. One normal activation per unit each player phase: move, then one Action (attack, support, item or Wait). Actions end normal movement unless stated&#10;otherwise. Free and Mode skills do not spend that action. A round is one player phase plus one enemy phase; 1/round uses reset at player-phase start. Map uses reset only on a new battle or restart. Durations measured in target activations count the&#10;next N activation starts after application and end after the last such activation; a regeneration tick occurs at each counted start. An effect ending at your next activation expires before your movement; an effect ending at activation end may be used&#10;during it." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="2968.0499999999997" width="1544" height="81.60000000000001" as="geometry" /></mxCell><mxCell id="vey17_panel_161" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e0e8f0;strokeColor=#e0e8f0;" vertex="1" parent="1"><mxGeometry x="40" y="3084.6499999999996" width="1580" height="121.69999999999999" as="geometry" /></mxCell><mxCell id="vey17_text_162" value="Combat and movement" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="3096.6499999999996" width="1544" height="27.6" as="geometry" /></mxCell><mxCell id="vey17_text_163" value="An attack skill replaces the normal attack and uses normal hit, block, crit, counter and speed follow-up rules unless stated. One opening strike per initiated exchange; an ordinary melee strike uses Str + might vs Def, magic uses Mag + might vs Res. A&#10;single magical skill strike without listed Hit uses 85 Hit and no speed follow-up. Prevention of a counter also prevents defender follow-up and Riposte. All distances and adjacency are cardinal Manhattan distance. Movement must follow a walkable path&#10;with normal terrain costs unless stated; swaps and pushes require legal destinations. Bonus movement is not a new activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="3128.6499999999996" width="1544" height="62.7" as="geometry" /></mxCell><mxCell id="vey17_panel_164" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e0e8f0;strokeColor=#e0e8f0;" vertex="1" parent="1"><mxGeometry x="40" y="3226.3499999999995" width="1580" height="159.5" as="geometry" /></mxCell><mxCell id="vey17_text_165" value="Stacking and reactions" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="3238.3499999999995" width="1544" height="27.6" as="geometry" /></mxCell><mxCell id="vey17_text_166" value="Hit, Crit, Block and Avoid bonuses are percentage points. Round down fractional damage/healing unless specified; HP stays between 0 and maximum. Apply percentage damage changes to resolved strike damage after mitigation/block, before HP loss.&#10;Outgoing skill damage scalars multiply with the strongest applicable incoming damage reduction; multiple incoming reductions do not stack. Same-name bonuses refresh; different named stat bonuses stack, but each movement trigger grants a choice&#10;of one bonus move per exchange/action. Generated splash, turret, Husk and reaction strikes do not trigger additional skills unless explicitly stated. Death bookkeeping still runs; kills by a controlled Husk or turret credit the owner with normal killer XP.&#10;Temporary units themselves award no XP when destroyed. A defeated caster loses auras immediately, but already applied timed statuses expire normally. One interception per exchange; controller chooses among eligible defenders. Resolve displacement&#10;after combat, never midway through its strike order." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="3270.3499999999995" width="1544" height="100.50000000000001" as="geometry" /></mxCell><mxCell id="vey17_panel_167" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e0e8f0;strokeColor=#e0e8f0;" vertex="1" parent="1"><mxGeometry x="40" y="3405.8499999999995" width="1580" height="121.69999999999999" as="geometry" /></mxCell><mxCell id="vey17_text_168" value="Status and content boundaries" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="3417.8499999999995" width="1544" height="27.6" as="geometry" /></mxCell><mxCell id="vey17_text_169" value="Pinned: -2 Move, minimum 1. Shaken: -15 Hit. Exposed: -3 Def and -3 Res. Bleed: lose 3 HP at each of the next 2 activation starts; can kill. Stat penalties never reduce Move below 1 unless explicitly 0. A target can hold one named body enhancement;&#10;replacing it does not erase owed penalties. Healing cannot revive; life-saving wards do not stack, and only one is consumed on a lethal strike. Proposed hooks include active skills, timed statuses, orders, entry reactions and temporary units; implement&#10;those hooks before shipping these definitions. These pages do not alter Mihata or grant new permanent campaign systems." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="3449.8499999999995" width="1544" height="62.7" as="geometry" /></mxCell></root></mxGraphModel></diagram>
  <diagram id="veySkills17" name="Veyrhold Disciplines"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2380" pageHeight="2055" math="0" shadow="0" background="#f7f4ee"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="veySkills17_panel_1" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2380" height="12" as="geometry" /></mxCell><mxCell id="veySkills17_text_2" value="VEYRHOLD / PERSONAL DISCIPLINES" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=32;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="35" width="2300" height="49.2" as="geometry" /></mxCell><mxCell id="veySkills17_text_3" value="A prepared shot, a useful tool or an inscription that holds. These choices support the person using the machinery." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="92.2" width="2300" height="27.6" as="geometry" /></mxCell><mxCell id="veySkills17_panel_4" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e0e8f0;strokeColor=#e0e8f0;" vertex="1" parent="1"><mxGeometry x="40" y="131.8" width="2300" height="102.8" as="geometry" /></mxCell><mxCell id="veySkills17_text_5" value="Six choices, one character" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="143.8" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="veySkills17_text_6" value="Choose exactly one skill from each numbered column, two per tier. Mix rows freely within this board; no prior skill in the same row is required. A skill naming another technique includes that technique only when explicitly stated. Equipment requirements still apply. Class signature skills come from the separate promotion tree. Values and progression economy are&#10;first-pass proposals." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="175.8" width="2264" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="veySkills17_text_7" value="CHOICE 1 / TIER 1" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60.0" y="266.6" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_8" value="CHOICE 2 / TIER 1" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="266.6" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_9" value="CHOICE 3 / TIER 2" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="266.6" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_10" value="CHOICE 4 / TIER 2" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1199.0" y="266.6" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_11" value="CHOICE 5 / TIER 3" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="266.6" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_12" value="CHOICE 6 / TIER 3" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="266.6" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_13" value="BALLISTICS" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=22;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="302.6" width="2260" height="35.7" as="geometry" /></mxCell><mxCell id="veySkills17_panel_14" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="60.0" y="350.3" width="361.6666666666667" height="189.95000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_panel_15" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="60.0" y="350.3" width="5" height="189.95000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_16" value="Brace Shot [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="veySkills17_panel_14"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="veySkills17_text_17" value="Trade mobility for a settled shot." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="veySkills17_panel_14"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_18" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="veySkills17_panel_14"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_19" value="Set remaining normal Move to 0, then make a&#10;firearm attack with +15 Hit on the opening strike." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="veySkills17_panel_14"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="veySkills17_panel_20" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="350.3" width="361.6666666666667" height="227.75" as="geometry" /></mxCell><mxCell id="veySkills17_panel_21" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="350.3" width="5" height="227.75" as="geometry" /></mxCell><mxCell id="veySkills17_text_22" value="Snapfire [Wait replacement]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="veySkills17_panel_20"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="veySkills17_text_23" value="Watch one lane instead of chasing a target." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="veySkills17_panel_20"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_24" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="veySkills17_panel_20"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_25" value="Until your next activation, fire at the first enemy&#10;entering legal firearm range for 60% ordinary&#10;damage. Hit check; no crit, counter or follow-up.&#10;Voluntary movement ends watch." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="veySkills17_panel_20"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="81.60000000000001" as="geometry" /></mxCell><mxCell id="veySkills17_panel_26" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="350.3" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_panel_27" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="350.3" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_28" value="Suppress [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="veySkills17_panel_26"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="veySkills17_text_29" value="The shot buys time even when it does not kill." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="veySkills17_panel_26"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_30" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="veySkills17_panel_26"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_31" value="Make a firearm attack at 75% strike damage. A&#10;damaging opening hit applies Pinned until your next&#10;activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="veySkills17_panel_26"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="veySkills17_panel_32" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1199.0" y="350.3" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_panel_33" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="1199.0" y="350.3" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_34" value="Corrected Shot [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="veySkills17_panel_32"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="veySkills17_text_35" value="Adjust the sight after a failed attempt." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="veySkills17_panel_32"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_36" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="veySkills17_panel_32"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_37" value="After your opening firearm strike misses, gain +20&#10;Hit for your next opening firearm strike before your&#10;next activation ends. Consumed on attempt." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="veySkills17_panel_32"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="veySkills17_panel_38" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="350.3" width="361.6666666666667" height="189.95000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_panel_39" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="350.3" width="5" height="189.95000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_40" value="Crossfire [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="veySkills17_panel_38"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="veySkills17_text_41" value="Reward the ally who already engaged the target." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="veySkills17_panel_38"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_42" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="veySkills17_panel_38"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_43" value="Your opening firearm strike gains +3 power if the&#10;target is adjacent to another living ally of yours." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="veySkills17_panel_38"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="veySkills17_panel_44" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="350.3" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_panel_45" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="350.3" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_46" value="Decisive Volley [Action; 1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="veySkills17_panel_44"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="veySkills17_text_47" value="Commit your best firing solution now." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="veySkills17_panel_44"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_48" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="veySkills17_panel_44"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_49" value="Make a firearm attack with +20 Hit. If you spent no&#10;Move this activation, opening strike also gains +4&#10;power. Ordinary counters and speed rules remain." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="veySkills17_panel_44"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="veySkills17_text_50" value="ENGINEERING" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=22;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="613.05" width="2260" height="35.7" as="geometry" /></mxCell><mxCell id="veySkills17_panel_51" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="60.0" y="660.75" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_panel_52" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="60.0" y="660.75" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_53" value="Field Kit [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="veySkills17_panel_51"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="veySkills17_text_54" value="A prepared tool gives any build a useful job." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="veySkills17_panel_51"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_55" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="veySkills17_panel_51"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_56" value="Heal an adjacent construct or device for 12 HP. You&#10;may instead give an adjacent living ally +2 Def until&#10;your next activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="veySkills17_panel_51"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="veySkills17_panel_57" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="660.75" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_panel_58" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="660.75" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_59" value="Portable Cover [Action; 1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="veySkills17_panel_57"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="veySkills17_text_60" value="Bring your own piece of defensible ground." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="veySkills17_panel_57"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_61" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="veySkills17_panel_57"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_62" value="Deploy a 20-HP, Def/Res 0 barricade on a free&#10;adjacent tile. Blocks walking, not line of sight. Does&#10;not require the Mechanic class." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="veySkills17_panel_57"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="veySkills17_panel_63" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="660.75" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_panel_64" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="660.75" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_65" value="Repulsor Tool [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="veySkills17_panel_63"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="veySkills17_text_66" value="Move the obstacle instead of trading blows." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="veySkills17_panel_63"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_67" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="veySkills17_panel_63"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_68" value="Push one adjacent unit, ally or enemy, 1 tile directly&#10;away if legal. No damage; an illegal destination&#10;makes the action unavailable." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="veySkills17_panel_63"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="veySkills17_panel_69" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1199.0" y="660.75" width="361.6666666666667" height="227.75" as="geometry" /></mxCell><mxCell id="veySkills17_panel_70" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="1199.0" y="660.75" width="5" height="227.75" as="geometry" /></mxCell><mxCell id="veySkills17_text_71" value="Recovery Crew [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="veySkills17_panel_69"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="veySkills17_text_72" value="Get the machinery and the operator back in&#10;position." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="veySkills17_panel_69"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="veySkills17_text_73" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="veySkills17_panel_69"><mxGeometry x="18" y="107.15" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_74" value="Move one adjacent friendly device 1 legal tile and&#10;heal it for 8 HP. Cannot move active enemy devices&#10;or occupied barricades." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="veySkills17_panel_69"><mxGeometry x="18" y="139.05" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="veySkills17_panel_75" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="660.75" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_panel_76" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="660.75" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_77" value="Targeting Lens [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="veySkills17_panel_75"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="veySkills17_text_78" value="Lend someone else your precision." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="veySkills17_panel_75"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_79" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="veySkills17_panel_75"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_80" value="One ally within 3 tiles gains +20 Hit for its next&#10;initiated ranged combat before your next activation.&#10;Works with bow, firearm or magical weapon." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="veySkills17_panel_75"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="veySkills17_panel_81" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="660.75" width="361.6666666666667" height="256.1" as="geometry" /></mxCell><mxCell id="veySkills17_panel_82" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="660.75" width="5" height="256.1" as="geometry" /></mxCell><mxCell id="veySkills17_text_83" value="Emergency Resupply [Action;&#10;1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="veySkills17_panel_81"><mxGeometry x="18" y="15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="veySkills17_text_84" value="The last prepared tool becomes available again." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="veySkills17_panel_81"><mxGeometry x="18" y="84.7" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_85" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="veySkills17_panel_81"><mxGeometry x="18" y="116.60000000000001" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_86" value="Restore 1 spent use of Field Kit, Portable Cover,&#10;Repulsor Tool, Recovery Crew or Targeting Lens to&#10;an ally within 2 tiles. Must know that skill; never&#10;exceed its map limit." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="veySkills17_panel_81"><mxGeometry x="18" y="148.5" width="325.6666666666667" height="81.60000000000001" as="geometry" /></mxCell><mxCell id="veySkills17_text_87" value="SANCTUM" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=22;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="951.85" width="2260" height="35.7" as="geometry" /></mxCell><mxCell id="veySkills17_panel_88" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="60.0" y="999.5500000000001" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_panel_89" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="60.0" y="999.5500000000001" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_90" value="Inscribed Plate [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="veySkills17_panel_88"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="veySkills17_text_91" value="A small ward answers the first spell." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="veySkills17_panel_88"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_92" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="veySkills17_panel_88"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_93" value="Your first damaging magical strike each round deals&#10;20% less damage. Use the stronger reduction if Null&#10;Plate also applies." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="veySkills17_panel_88"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="veySkills17_panel_94" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="999.5500000000001" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_panel_95" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="999.5500000000001" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_96" value="Unbind [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="veySkills17_panel_94"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="veySkills17_text_97" value="Undo a hostile inscription on a companion." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="veySkills17_panel_94"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_98" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="veySkills17_panel_94"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_99" value="Remove one chosen negative magical status from an&#10;ally within 2 tiles. If none exists, give +3 Res until&#10;your next activation instead." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="veySkills17_panel_94"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="veySkills17_panel_100" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="999.5500000000001" width="361.6666666666667" height="227.75" as="geometry" /></mxCell><mxCell id="veySkills17_panel_101" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="999.5500000000001" width="5" height="227.75" as="geometry" /></mxCell><mxCell id="veySkills17_text_102" value="Sanctuary Seal [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="veySkills17_panel_100"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="veySkills17_text_103" value="Choose the ground where someone can stand&#10;safely." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="veySkills17_panel_100"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="veySkills17_text_104" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="veySkills17_panel_100"><mxGeometry x="18" y="107.15" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_105" value="One ally within 2 tiles gains +4 Res until your next&#10;activation while it remains on its current tile. Moving&#10;ends the effect." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="veySkills17_panel_100"><mxGeometry x="18" y="139.05" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="veySkills17_panel_106" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1199.0" y="999.5500000000001" width="361.6666666666667" height="227.75" as="geometry" /></mxCell><mxCell id="veySkills17_panel_107" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="1199.0" y="999.5500000000001" width="5" height="227.75" as="geometry" /></mxCell><mxCell id="veySkills17_text_108" value="Purity Circuit [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="veySkills17_panel_106"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="veySkills17_text_109" value="Prevent the curse instead of treating it later." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="veySkills17_panel_106"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_110" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="veySkills17_panel_106"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_111" value="One ally within 3 tiles ignores the next negative&#10;magical status applied before your next activation.&#10;Consume only when it prevents a status; damage&#10;still applies." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="veySkills17_panel_106"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="81.60000000000001" as="geometry" /></mxCell><mxCell id="veySkills17_panel_112" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="999.5500000000001" width="361.6666666666667" height="256.1" as="geometry" /></mxCell><mxCell id="veySkills17_panel_113" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="999.5500000000001" width="5" height="256.1" as="geometry" /></mxCell><mxCell id="veySkills17_text_114" value="Counterpulse [Reaction;&#10;1/round]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="veySkills17_panel_112"><mxGeometry x="18" y="15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="veySkills17_text_115" value="Make the caster feel the ward answer." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="veySkills17_panel_112"><mxGeometry x="18" y="84.7" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_116" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="veySkills17_panel_112"><mxGeometry x="18" y="116.60000000000001" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_117" value="After surviving an initiating magical strike, apply&#10;Shaken to its caster until your next activation if it is&#10;within 3 tiles. This deals no damage and grants no&#10;attack." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="veySkills17_panel_112"><mxGeometry x="18" y="148.5" width="325.6666666666667" height="81.60000000000001" as="geometry" /></mxCell><mxCell id="veySkills17_panel_118" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="999.5500000000001" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_panel_119" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#3c597a;strokeColor=#3c597a;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="999.5500000000001" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_120" value="Consecration [Action; 1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="veySkills17_panel_118"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="veySkills17_text_121" value="A deliberate sanctuary for the decisive turn." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="veySkills17_panel_118"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_122" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="veySkills17_panel_118"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="veySkills17_text_123" value="Choose up to 3 allies within 2 tiles. They take 35%&#10;less magical strike damage and cannot gain new&#10;negative magical statuses until your next activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="veySkills17_panel_118"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="veySkills17_text_124" value="MECHANICAL CONTRACT / FIRST-PASS PROPOSAL" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=20;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1306.65" width="2300" height="33.0" as="geometry" /></mxCell><mxCell id="veySkills17_panel_125" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e0e8f0;strokeColor=#e0e8f0;" vertex="1" parent="1"><mxGeometry x="40" y="1354.65" width="2300" height="121.69999999999999" as="geometry" /></mxCell><mxCell id="veySkills17_text_126" value="Veyrhold rulings" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="1366.65" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="veySkills17_text_127" value="Devices are new stationary units: targetable, nonliving, occupy their tile, never counter or follow up, yield no XP/corpse, and vanish at map end. A turret lasts 3 player phases after deployment; it gets one controller-chosen shot at the start of each of those phases. No target means no shot. Turret attacks use physical power vs Def and the listed Hit minus target Avoid;&#10;no block without a shield, no crit/counter/follow-up. Owner Skill is captured when deployed. Wards are magical statuses; equipment modes, firearm marks and physical tools are not. Seal suppresses a timed magical status, not a class, form or equipment item. Buff durations keep ticking while suppressed. Firearms use existing weapon stats; this pass requires no&#10;magazine/reload economy. Targeted skills require visible targets and legal range." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="1398.65" width="2264" height="62.7" as="geometry" /></mxCell><mxCell id="veySkills17_panel_128" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e0e8f0;strokeColor=#e0e8f0;" vertex="1" parent="1"><mxGeometry x="40" y="1496.3500000000001" width="2300" height="121.69999999999999" as="geometry" /></mxCell><mxCell id="veySkills17_text_129" value="Action and timing" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="1508.3500000000001" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="veySkills17_text_130" value="First-pass design proposal, not an implementation claim. Numbers are starting balance values. One normal activation per unit each player phase: move, then one Action (attack, support, item or Wait). Actions end normal movement unless stated otherwise. Free and Mode skills do not spend that action. A round is one player phase plus one enemy phase; 1/round uses&#10;reset at player-phase start. Map uses reset only on a new battle or restart. Durations measured in target activations count the next N activation starts after application and end after the last such activation; a regeneration tick occurs at each counted start. An effect ending at your next activation expires before your movement; an effect ending at activation end may be&#10;used during it." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="1540.3500000000001" width="2264" height="62.7" as="geometry" /></mxCell><mxCell id="veySkills17_panel_131" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e0e8f0;strokeColor=#e0e8f0;" vertex="1" parent="1"><mxGeometry x="40" y="1638.0500000000002" width="2300" height="102.8" as="geometry" /></mxCell><mxCell id="veySkills17_text_132" value="Combat and movement" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="1650.0500000000002" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="veySkills17_text_133" value="An attack skill replaces the normal attack and uses normal hit, block, crit, counter and speed follow-up rules unless stated. One opening strike per initiated exchange; an ordinary melee strike uses Str + might vs Def, magic uses Mag + might vs Res. A single magical skill strike without listed Hit uses 85 Hit and no speed follow-up. Prevention of a counter also prevents&#10;defender follow-up and Riposte. All distances and adjacency are cardinal Manhattan distance. Movement must follow a walkable path with normal terrain costs unless stated; swaps and pushes require legal destinations. Bonus movement is not a new activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="1682.0500000000002" width="2264" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="veySkills17_panel_134" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e0e8f0;strokeColor=#e0e8f0;" vertex="1" parent="1"><mxGeometry x="40" y="1760.8500000000001" width="2300" height="121.69999999999999" as="geometry" /></mxCell><mxCell id="veySkills17_text_135" value="Stacking and reactions" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="1772.8500000000001" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="veySkills17_text_136" value="Hit, Crit, Block and Avoid bonuses are percentage points. Round down fractional damage/healing unless specified; HP stays between 0 and maximum. Apply percentage damage changes to resolved strike damage after mitigation/block, before HP loss. Outgoing skill damage scalars multiply with the strongest applicable incoming damage reduction; multiple incoming&#10;reductions do not stack. Same-name bonuses refresh; different named stat bonuses stack, but each movement trigger grants a choice of one bonus move per exchange/action. Generated splash, turret, Husk and reaction strikes do not trigger additional skills unless explicitly stated. Death bookkeeping still runs; kills by a controlled Husk or turret credit the owner with&#10;normal killer XP. Temporary units themselves award no XP when destroyed. A defeated caster loses auras immediately, but already applied timed statuses expire normally. One interception per exchange; controller chooses among eligible defenders. Resolve displacement after combat, never midway through its strike order." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="1804.8500000000001" width="2264" height="62.7" as="geometry" /></mxCell><mxCell id="veySkills17_panel_137" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e0e8f0;strokeColor=#e0e8f0;" vertex="1" parent="1"><mxGeometry x="40" y="1902.5500000000002" width="2300" height="102.8" as="geometry" /></mxCell><mxCell id="veySkills17_text_138" value="Status and content boundaries" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#3c597a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="1914.5500000000002" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="veySkills17_text_139" value="Pinned: -2 Move, minimum 1. Shaken: -15 Hit. Exposed: -3 Def and -3 Res. Bleed: lose 3 HP at each of the next 2 activation starts; can kill. Stat penalties never reduce Move below 1 unless explicitly 0. A target can hold one named body enhancement; replacing it does not erase owed penalties. Healing cannot revive; life-saving wards do not stack, and only one is&#10;consumed on a lethal strike. Proposed hooks include active skills, timed statuses, orders, entry reactions and temporary units; implement those hooks before shipping these definitions. These pages do not alter Mihata or grant new permanent campaign systems." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="1946.5500000000002" width="2264" height="43.800000000000004" as="geometry" /></mxCell></root></mxGraphModel></diagram>
  <diagram id="iG80AndFLfV_N3RRXoKr" name="World Info">
    <mxGraphModel dx="1689" dy="1044" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s2RB0dUuLB84cX1tktCu-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=20;fontStyle=1" value="World Info" vertex="1">
          <mxGeometry height="40" width="120" x="80" y="40" as="geometry" />
        </mxCell>
        <mxCell id="s2RB0dUuLB84cX1tktCu-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;strong&gt;Veyrhold Synod&lt;/strong&gt;: northern mountain nation. Engineers, magitech, religious doctrine, strict social order. Body-altering alchemy is considered profane." vertex="1">
          <mxGeometry height="160" width="200" x="320" y="200" as="geometry" />
        </mxCell>
        <mxCell id="s2RB0dUuLB84cX1tktCu-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;strong&gt;Kharazad Dominion&lt;/strong&gt;: southern desert nation. Martial + mage culture, wealthy, decadent, corrupt, heavily involved in slave and sex trading." vertex="1">
          <mxGeometry height="160" width="200" x="80" y="200" as="geometry" />
        </mxCell>
        <mxCell id="s2RB0dUuLB84cX1tktCu-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;strong&gt;Nerath Enclave&lt;/strong&gt;: isolated biomancer and alchemist nation. Healing, fleshcraft, necromancy, body modification. Feared and treated as anathema despite having the world’s best physicians." vertex="1">
          <mxGeometry height="160" width="200" x="560" y="200" as="geometry" />
        </mxCell>
        <mxCell id="s2RB0dUuLB84cX1tktCu-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1" value="Nations" vertex="1">
          <mxGeometry height="40" width="120" x="80" y="120" as="geometry" />
        </mxCell>
        <mxCell id="s2RB0dUuLB84cX1tktCu-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=bottom;" value="&lt;div style=&quot;line-height: 60%;&quot;&gt;Continent Name:&lt;br&gt;&lt;p&gt;&lt;strong&gt;Vaelora&lt;/strong&gt;&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="120" x="280" y="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="kharazad-arms-15" name="Kharazad Arms"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2380" pageHeight="4432" math="0" shadow="0" background="#f7f4ee"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="kharazad-arms-15_panel_1" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2380" height="12" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_2" value="KHARAZAD / THE BODY IS THE WEAPON" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=32;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="35" width="2300" height="49.2" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_3" value="Internal magic becomes martial mastery. Build a duelist, protector, charging lancer, spearwall, berserker or executioner." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="92.2" width="2300" height="27.6" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_4" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f4e7ce;strokeColor=#f4e7ce;" vertex="1" parent="1"><mxGeometry x="40" y="131.8" width="2300" height="102.8" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_5" value="Promotion and personal discipline" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="143.8" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_6" value="Follow connected classes, keeping two skills from each learned class; explicit upgrades replace their earlier versions. These are first-pass proposals. Six independent discipline choices below add personal expression without replacing your class. No attribute gates; unlock levels, costs and respec rules remain undecided. Conventional spellcaster trees are outside this martial&#10;Arms page." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="175.8" width="2264" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_7" value="SWORD TRADITION" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=25;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="274.6" width="2260" height="39.75" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_8" value="Confidence, precision and the discipline to invite a dangerous exchange." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#202b30;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="324.35" width="2260" height="27.6" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_9" value="DISCIPLINE" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="366.95000000000005" width="560" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_10" value="SPECIALIZATION" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="366.95000000000005" width="560" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_11" value="MASTERY" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1660" y="366.95000000000005" width="560" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_12" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="890" y="401.95000000000005" width="560" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_13" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="890" y="401.95000000000005" width="5" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_14" value="Duelist" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_12"><mxGeometry x="18" y="15" width="524" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_15" value="Choose your opponent and make their first mistake yours to punish." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_12"><mxGeometry x="18" y="56.35" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_16" value="Challenge [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_12"><mxGeometry x="18" y="88.25" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_17" value="Make a sword attack. If the target has no adjacent living ally of its own, gain +3&#10;attack power for the exchange." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_12"><mxGeometry x="18" y="120.15" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_18" value="Riposte [Reaction]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_12"><mxGeometry x="18" y="170.95000000000002" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_19" value="After dodging or fully blocking the initiating melee strike, make one extra strike&#10;before your ordinary counter. Requires a legal weapon range; no reaction chains." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_12"><mxGeometry x="18" y="202.85000000000002" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_20" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1660" y="401.95000000000005" width="560" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_21" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="1660" y="401.95000000000005" width="5" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_22" value="Blade Dancer" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_20"><mxGeometry x="18" y="15" width="524" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_23" value="Calm enough to wait, quick enough to make the opening count." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_20"><mxGeometry x="18" y="56.35" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_24" value="Perfect Draw [Wait replacement]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_20"><mxGeometry x="18" y="88.25" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_25" value="Wait and prepare until your next activation ends. Your next opening sword strike&#10;ignores 30% Def and gains +20 Crit; consume on attempt." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_20"><mxGeometry x="18" y="120.15" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_26" value="Flowing Chain [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_20"><mxGeometry x="18" y="170.95000000000002" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_27" value="After initiating sword combat and surviving, gain +15 Avoid until your next&#10;activation. Does not stack." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_20"><mxGeometry x="18" y="202.85000000000002" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_edge_28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#91521d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="kharazad-arms-15_panel_12" target="kharazad-arms-15_panel_20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_29" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="890" y="699.6000000000001" width="560" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_30" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="890" y="699.6000000000001" width="5" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_31" value="Palace Guard" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_29"><mxGeometry x="18" y="15" width="524" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_32" value="Your charge is safe while you hold your position." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_29"><mxGeometry x="18" y="56.35" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_33" value="Intercept [Reaction; 1/round]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_29"><mxGeometry x="18" y="88.25" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_34" value="Swap with an adjacent ally before a single-target attack and become its defender, if&#10;both tiles are legal. One interception per exchange." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_29"><mxGeometry x="18" y="120.15" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_35" value="Royal Stance [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_29"><mxGeometry x="18" y="170.95000000000002" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_36" value="After Wait, gain +3 Def and +3 Res until your next activation. Requires an equipped&#10;shield." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_29"><mxGeometry x="18" y="202.85000000000002" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_37" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1660" y="699.6000000000001" width="560" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_38" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="1660" y="699.6000000000001" width="5" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_39" value="Sun Sentinel" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_37"><mxGeometry x="18" y="15" width="524" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_40" value="Turn the blow meant for someone else into an oath fulfilled." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_37"><mxGeometry x="18" y="56.35" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_41" value="Oath Strike [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_37"><mxGeometry x="18" y="88.25" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_42" value="After Intercept resolves, your next initiated sword combat before your next activation&#10;ends gains +4 attack power and +15 Hit." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_37"><mxGeometry x="18" y="120.15" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_43" value="Sunward [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_37"><mxGeometry x="18" y="170.95000000000002" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_44" value="Choose an adjacent ally. Until your next activation, their strike damage is reduced by&#10;35% while they remain adjacent; you cannot be pushed or pulled." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_37"><mxGeometry x="18" y="202.85000000000002" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_edge_45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#91521d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="kharazad-arms-15_panel_29" target="kharazad-arms-15_panel_37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_46" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="120" y="519.6000000000001" width="560" height="253.75000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_47" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="120" y="519.6000000000001" width="5" height="253.75000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_48" value="Fighter" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_46"><mxGeometry x="18" y="15" width="524" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_49" value="Win close exchanges through deliberate footwork." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_46"><mxGeometry x="18" y="56.35" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_50" value="Measured Cut [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_46"><mxGeometry x="18" y="88.25" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_51" value="Make a sword attack with +15 Hit on the opening strike. For this exchange, enemy&#10;counters suffer -10 Hit." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_46"><mxGeometry x="18" y="120.15" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_52" value="Footwork [After combat; 1/activation]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_46"><mxGeometry x="18" y="170.95000000000002" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_53" value="After initiating melee combat, move 1 legal tile. Does not grant another action." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_46"><mxGeometry x="18" y="202.85000000000002" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_edge_54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#91521d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="kharazad-arms-15_panel_46" target="kharazad-arms-15_panel_12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_edge_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#91521d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="kharazad-arms-15_panel_46" target="kharazad-arms-15_panel_29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_56" value="SPEAR TRADITION" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=25;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1052.2500000000002" width="2260" height="39.75" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_57" value="Own the distance: commit to the charge or make the enemy come to you." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#202b30;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="1102.0000000000002" width="2260" height="27.6" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_58" value="DISCIPLINE" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="1144.6000000000001" width="560" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_59" value="SPECIALIZATION" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="1144.6000000000001" width="560" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_60" value="MASTERY" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1660" y="1144.6000000000001" width="560" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_61" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="890" y="1179.6000000000001" width="560" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_62" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="890" y="1179.6000000000001" width="5" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_63" value="Sandstrider" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_61"><mxGeometry x="18" y="15" width="524" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_64" value="Cross the ground other soldiers fear to break the line." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_61"><mxGeometry x="18" y="56.35" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_65" value="Vault [Move modifier; 1/activation]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_61"><mxGeometry x="18" y="88.25" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_66" value="During movement cross one occupied tile and land on the next free tile in the same&#10;cardinal direction. Pay 2 Move; cannot cross walls or map edges." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_61"><mxGeometry x="18" y="120.15" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_67" value="Dune Step [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_61"><mxGeometry x="18" y="170.95000000000002" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_68" value="Sand, rubble and hills cost 1 Move per tile. Does not grant access to impassable&#10;terrain." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_61"><mxGeometry x="18" y="202.85000000000002" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_69" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1660" y="1179.6000000000001" width="560" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_70" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="1660" y="1179.6000000000001" width="5" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_71" value="Dune Lance" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_69"><mxGeometry x="18" y="15" width="524" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_72" value="Commit, strike and escape before the line closes." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_69"><mxGeometry x="18" y="56.35" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_73" value="Sirocco Thrust [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_69"><mxGeometry x="18" y="88.25" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_74" value="Make a spear attack. If Charge is active and the opening strike deals damage, push&#10;the target 1 tile directly away after the exchange, if legal." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_69"><mxGeometry x="18" y="120.15" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_75" value="Afterimage Step [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_69"><mxGeometry x="18" y="170.95000000000002" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_76" value="After a combat with Charge active, move up to 2 legal tiles. Does not grant another&#10;attack or trigger entry reactions." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_69"><mxGeometry x="18" y="202.85000000000002" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_edge_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#91521d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="kharazad-arms-15_panel_61" target="kharazad-arms-15_panel_69"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_78" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="890" y="1477.2500000000002" width="560" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_79" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="890" y="1477.2500000000002" width="5" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_80" value="Phalanx" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_78"><mxGeometry x="18" y="15" width="524" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_81" value="The spear is a boundary, not merely a weapon." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_78"><mxGeometry x="18" y="56.35" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_82" value="Set Spear [Wait replacement]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_78"><mxGeometry x="18" y="88.25" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_83" value="Until your next activation, strike the first enemy entering an adjacent tile for 60%&#10;ordinary spear damage. Hit check applies; no crit, follow-up or counter." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_78"><mxGeometry x="18" y="120.15" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_84" value="Formation [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_78"><mxGeometry x="18" y="170.95000000000002" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_85" value="While you have a spear equipped, adjacent allies gain +2 Def. Multiple Formation&#10;auras do not stack." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_78"><mxGeometry x="18" y="202.85000000000002" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_86" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1660" y="1477.2500000000002" width="560" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_87" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="1660" y="1477.2500000000002" width="5" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_88" value="Sand Warden" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_86"><mxGeometry x="18" y="15" width="524" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_89" value="An advancing enemy must pay for every doorway." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_86"><mxGeometry x="18" y="56.35" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_90" value="Spearwall [Upgrade]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_86"><mxGeometry x="18" y="88.25" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_91" value="Set Spear can strike 2 different enemies before expiring. Each damaging hit ends that&#10;enemy's movement; its action remains available." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_86"><mxGeometry x="18" y="120.15" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_92" value="Hold Formation [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_86"><mxGeometry x="18" y="170.95000000000002" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_93" value="While Set Spear is armed, you and adjacent allies cannot be pushed or pulled. Moving&#10;voluntarily ends Set Spear." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_86"><mxGeometry x="18" y="202.85000000000002" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_edge_94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#91521d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="kharazad-arms-15_panel_78" target="kharazad-arms-15_panel_86"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_95" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="120" y="1297.2500000000002" width="560" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_96" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="120" y="1297.2500000000002" width="5" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_97" value="Lancer" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_95"><mxGeometry x="18" y="15" width="524" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_98" value="A practiced reach makes open ground yours." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_95"><mxGeometry x="18" y="56.35" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_99" value="Long Thrust [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_95"><mxGeometry x="18" y="88.25" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_100" value="Make a spear attack at exactly 2 tiles with -15 Hit. For this exchange, your spear may&#10;also follow up at range 2; enemy counters require their own legal range." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_95"><mxGeometry x="18" y="120.15" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_101" value="Charge [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_95"><mxGeometry x="18" y="170.95000000000002" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_102" value="If you spent at least 3 normal Move this activation, your opening spear strike gains&#10;+3 power. Bonus movement and teleports do not count." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_95"><mxGeometry x="18" y="202.85000000000002" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_edge_103" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#91521d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="kharazad-arms-15_panel_95" target="kharazad-arms-15_panel_61"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_edge_104" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#91521d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="kharazad-arms-15_panel_95" target="kharazad-arms-15_panel_78"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_105" value="AXE TRADITION" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=25;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1829.9000000000003" width="2260" height="39.75" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_106" value="Choose the frightening commitment: overwhelming a target or pulling it apart for the team." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#202b30;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="60" y="1879.6500000000003" width="2260" height="27.6" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_107" value="DISCIPLINE" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="1922.2500000000002" width="560" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_108" value="SPECIALIZATION" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="1922.2500000000002" width="560" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_109" value="MASTERY" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1660" y="1922.2500000000002" width="560" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_110" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="890" y="1957.2500000000002" width="560" height="253.75000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_111" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="890" y="1957.2500000000002" width="5" height="253.75000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_112" value="Berserker" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_110"><mxGeometry x="18" y="15" width="524" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_113" value="Stay dangerous while wounded; risk is part of the build." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_110"><mxGeometry x="18" y="56.35" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_114" value="Blood Rush [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_110"><mxGeometry x="18" y="88.25" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_115" value="While below 50% HP, gain +3 physical attack power." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_110"><mxGeometry x="18" y="120.15" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_116" value="Reckless Swing [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_110"><mxGeometry x="18" y="152.05" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_117" value="Make an axe attack with +20 Hit for the exchange. You suffer -3 Def until your next&#10;activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_110"><mxGeometry x="18" y="183.95000000000002" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_118" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1660" y="1957.2500000000002" width="560" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_119" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="1660" y="1957.2500000000002" width="5" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_120" value="Bloodstorm" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_118"><mxGeometry x="18" y="15" width="524" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_121" value="A wounded fighter who makes one breach become two." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_118"><mxGeometry x="18" y="56.35" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_122" value="Cleaving Rage [After combat; 1/activation]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_118"><mxGeometry x="18" y="88.25" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_123" value="After killing your selected target with an axe, strike one other enemy adjacent to you&#10;for 50% ordinary axe damage. No crit, counter or further skill triggers." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_118"><mxGeometry x="18" y="120.15" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_124" value="Last Roar [Passive; 1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_118"><mxGeometry x="18" y="170.95000000000002" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_125" value="A lethal strike leaves you at 1 HP. Gain +15 Hit until your next activation ends. The&#10;next strike can still kill you." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_118"><mxGeometry x="18" y="202.85000000000002" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_edge_126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#91521d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="kharazad-arms-15_panel_110" target="kharazad-arms-15_panel_118"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_127" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="890" y="2254.9" width="560" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_128" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="890" y="2254.9" width="5" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_129" value="Breaker" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_127"><mxGeometry x="18" y="15" width="524" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_130" value="Make the strongest enemy easier for everyone to finish." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_127"><mxGeometry x="18" y="56.35" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_131" value="Armor Split [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_127"><mxGeometry x="18" y="88.25" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_132" value="Make an axe attack. A damaging opening strike applies -4 Def until your next&#10;activation; the opening strike uses the original Def." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_127"><mxGeometry x="18" y="120.15" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_133" value="Crushing Hook [Upgrade]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_127"><mxGeometry x="18" y="170.95000000000002" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_134" value="A damaging Hooking Blow also applies Pinned until your next activation, even if the&#10;pull is blocked." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_127"><mxGeometry x="18" y="202.85000000000002" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_135" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1660" y="2254.9" width="560" height="253.75000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_136" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="1660" y="2254.9" width="5" height="253.75000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_137" value="Headsman" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_135"><mxGeometry x="18" y="15" width="524" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_138" value="Execute the threat the team has prepared for you." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_135"><mxGeometry x="18" y="56.35" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_139" value="Final Sentence [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_135"><mxGeometry x="18" y="88.25" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_140" value="Make an axe attack. Against an Exposed, Pinned or Armor Split target, the opening&#10;strike gains +5 power and +15 Hit." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_135"><mxGeometry x="18" y="120.15" width="524" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_141" value="Dread Presence [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_135"><mxGeometry x="18" y="170.95000000000002" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_142" value="Adjacent enemies suffer -10 Hit. Multiple copies do not stack." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_135"><mxGeometry x="18" y="202.85000000000002" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_edge_143" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#91521d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="kharazad-arms-15_panel_127" target="kharazad-arms-15_panel_135"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_144" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="120" y="2074.9" width="560" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_145" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="120" y="2074.9" width="5" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_146" value="Reaver" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_144"><mxGeometry x="18" y="15" width="524" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_147" value="A heavy weapon makes a promise you must be willing to keep." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_144"><mxGeometry x="18" y="56.35" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_148" value="Heavy Arc [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_144"><mxGeometry x="18" y="88.25" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_149" value="Make an axe attack with +4 attack power and -15 Hit for the exchange." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_144"><mxGeometry x="18" y="120.15" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_150" value="Hooking Blow [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_144"><mxGeometry x="18" y="152.05" width="524" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_151" value="Make a range-1 axe attack with 25% less strike damage. After combat and a&#10;damaging opening hit, step 1 tile directly away and pull the target into your vacated&#10;tile. Both moves must be legal." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_144"><mxGeometry x="18" y="183.95000000000002" width="524" height="62.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_edge_152" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#91521d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="kharazad-arms-15_panel_144" target="kharazad-arms-15_panel_110"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_edge_153" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#91521d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="kharazad-arms-15_panel_144" target="kharazad-arms-15_panel_127"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_154" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f4e7ce;strokeColor=#f4e7ce;" vertex="1" parent="1"><mxGeometry x="40" y="2587.55" width="2300" height="83.9" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_155" value="Six warrior choices" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="2599.55" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_156" value="Choose exactly one skill from each numbered column. Assault, Defense and Body Channeling may be mixed freely. These skills support a martial character regardless of their promotion path; obey explicit weapon requirements. No earlier choice is required." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="2631.55" width="2264" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_157" value="CHOICE 1 / TIER 1" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60.0" y="2691.4500000000003" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_158" value="CHOICE 2 / TIER 1" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="2691.4500000000003" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_159" value="CHOICE 3 / TIER 2" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="2691.4500000000003" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_160" value="CHOICE 4 / TIER 2" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1199.0" y="2691.4500000000003" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_161" value="CHOICE 5 / TIER 3" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="2691.4500000000003" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_162" value="CHOICE 6 / TIER 3" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="2691.4500000000003" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_163" value="ASSAULT" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=22;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="2727.4500000000003" width="2260" height="35.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_164" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="60.0" y="2775.15" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_165" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="60.0" y="2775.15" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_166" value="Lunge [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_164"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_167" value="Commit the last step to reach your opponent." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_164"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_168" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_164"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_169" value="If an enemy is exactly 2 cardinal tiles away and the&#10;intervening tile is free, step there at no Move cost&#10;and make a melee attack." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_164"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_170" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="2775.15" width="361.6666666666667" height="237.2" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_171" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="2775.15" width="5" height="237.2" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_172" value="Flow Through [After combat;&#10;1/activation]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_170"><mxGeometry x="18" y="15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_173" value="Keep the opponent turning toward you." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_170"><mxGeometry x="18" y="84.7" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_174" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_170"><mxGeometry x="18" y="116.60000000000001" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_175" value="After initiating melee combat, move up to 2 legal&#10;tiles, ending adjacent to the target or on its vacated&#10;tile if it died. No new action." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_170"><mxGeometry x="18" y="148.5" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_176" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="2775.15" width="361.6666666666667" height="227.75" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_177" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="2775.15" width="5" height="227.75" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_178" value="Cleave [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_176"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_179" value="A broad commitment catches a second foe." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_176"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_180" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_176"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_181" value="Make a melee attack at 75% strike damage. After&#10;combat, one other enemy adjacent to you takes a&#10;50% ordinary-damage strike; no crit, counter or skill&#10;triggers." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_176"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="81.60000000000001" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_182" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1199.0" y="2775.15" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_183" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="1199.0" y="2775.15" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_184" value="Pressure [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_182"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_185" value="Force an enemy to defend rather than overwhelm." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_182"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_186" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_182"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_187" value="If the target survives your initiated melee combat, it&#10;cannot make speed follow-ups until your next&#10;activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_182"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_188" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="2775.15" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_189" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="2775.15" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_190" value="Overrun [After kill; 1/activation]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_188"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_191" value="A fallen enemy opens the way forward." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_188"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_192" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_188"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_193" value="After your selected melee target dies, move into its&#10;legal vacated tile and then spend any unused normal&#10;Move. Does not restore your action." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_188"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_194" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="2775.15" width="361.6666666666667" height="237.2" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_195" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="2775.15" width="5" height="237.2" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_196" value="Execution Window [Action;&#10;1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_194"><mxGeometry x="18" y="15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_197" value="Exploit the opening the formation prepared." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_194"><mxGeometry x="18" y="84.7" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_198" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_194"><mxGeometry x="18" y="116.60000000000001" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_199" value="Make a melee attack against a Pinned or Exposed&#10;enemy. It cannot counter this exchange; opening&#10;strike gains +4 power." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_194"><mxGeometry x="18" y="148.5" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_200" value="DEFENSE" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=22;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="3047.35" width="2260" height="35.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_201" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="60.0" y="3095.0499999999997" width="361.6666666666667" height="227.75" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_202" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="60.0" y="3095.0499999999997" width="5" height="227.75" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_203" value="Brace [Wait replacement]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_201"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_204" value="Plant your feet and absorb the commitment." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_201"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_205" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_201"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_206" value="Until your next activation, reduce the next strike&#10;damage by 35% and resist push/pull. Damage&#10;reduction is consumed on a damaging strike;&#10;immunity lasts." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_201"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="81.60000000000001" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_207" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="3095.0499999999997" width="361.6666666666667" height="189.95000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_208" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="3095.0499999999997" width="5" height="189.95000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_209" value="Cover Ally [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_207"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_210" value="Put your protection where it matters." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_207"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_211" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_207"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_212" value="An adjacent ally gains +3 Def/+3 Res until your next&#10;activation while it stays adjacent to you." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_207"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_213" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="3095.0499999999997" width="361.6666666666667" height="237.2" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_214" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="3095.0499999999997" width="5" height="237.2" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_215" value="Zone Control [Wait&#10;replacement]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_213"><mxGeometry x="18" y="15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_216" value="Claim the doorway." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_213"><mxGeometry x="18" y="84.7" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_217" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_213"><mxGeometry x="18" y="116.60000000000001" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_218" value="Until your next activation, the first enemy entering&#10;an adjacent tile ends its movement. It may still&#10;attack; voluntary movement ends your stance." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_213"><mxGeometry x="18" y="148.5" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_219" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1199.0" y="3095.0499999999997" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_220" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="1199.0" y="3095.0499999999997" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_221" value="Deflect [Reaction; 1/round]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_219"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_222" value="Survive the first blow; deny the second." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_219"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_223" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_219"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_224" value="After surviving an enemy initiating melee strike,&#10;cancel that attacker's speed follow-up for this&#10;exchange. Does not cancel your ordinary counter." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_219"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_225" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="3095.0499999999997" width="361.6666666666667" height="237.2" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_226" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="3095.0499999999997" width="5" height="237.2" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_227" value="Reversal [After combat;&#10;1/round]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_225"><mxGeometry x="18" y="15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_228" value="Turn their overcommitment against them." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_225"><mxGeometry x="18" y="84.7" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_229" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_225"><mxGeometry x="18" y="116.60000000000001" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_230" value="If you dodged or fully blocked the opening melee&#10;strike, you may swap with the surviving attacker&#10;after the exchange if both tiles are legal." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_225"><mxGeometry x="18" y="148.5" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_231" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="3095.0499999999997" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_232" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="3095.0499999999997" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_233" value="Last Bastion [Passive; 1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_231"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_234" value="Still standing when the line needs you." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_231"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_235" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_231"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_236" value="A lethal strike leaves you at 1 HP; gain +4 Def/+4&#10;Res until your next activation. Your next activation&#10;has 0 normal Move. Further damage can kill you." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_231"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_237" value="BODY CHANNELING" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=22;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="3367.2499999999995" width="2260" height="35.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_238" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="60.0" y="3414.9499999999994" width="361.6666666666667" height="237.2" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_239" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="60.0" y="3414.9499999999994" width="5" height="237.2" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_240" value="Reinforcement [Mode;&#10;1/activation]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_238"><mxGeometry x="18" y="15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_241" value="Shape your body for the ground ahead." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_238"><mxGeometry x="18" y="84.7" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_242" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_238"><mxGeometry x="18" y="116.60000000000001" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_243" value="At activation start choose Swift (walkable difficult&#10;terrain costs 1 Move) or Rooted (push/pull&#10;immunity). Lasts until your next activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_238"><mxGeometry x="18" y="148.5" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_244" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="3414.9499999999994" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_245" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="3414.9499999999994" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_246" value="Mana Edge [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_244"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_247" value="Let the weapon carry your inner magic." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_244"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_248" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_244"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_249" value="Make a melee attack using Mag + weapon might&#10;against Res instead of physical power and Def.&#10;Physical armor-breaking effects do not apply." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_244"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_250" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="3414.9499999999994" width="361.6666666666667" height="237.2" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_251" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="3414.9499999999994" width="5" height="237.2" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_252" value="Surge Step [Before combat;&#10;1/activation]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_250"><mxGeometry x="18" y="15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_253" value="A burst of control closes the gap." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_250"><mxGeometry x="18" y="84.7" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_254" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_250"><mxGeometry x="18" y="116.60000000000001" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_255" value="Immediately before initiating melee combat, move 1&#10;tile at no Move cost. Destination must be free and&#10;walkable; cannot cross walls or units." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_250"><mxGeometry x="18" y="148.5" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_256" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1199.0" y="3414.9499999999994" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_257" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="1199.0" y="3414.9499999999994" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_258" value="Ward Skin [Reaction; 1/round]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_256"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_259" value="Close your guard to the spell." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_256"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_260" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_256"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_261" value="When a magical attack targets you, forgo all your&#10;return strikes to reduce its strike damage by 35% for&#10;the exchange. Usable even without a legal counter." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_256"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_262" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="3414.9499999999994" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_263" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="3414.9499999999994" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_264" value="Force Pulse [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_262"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_265" value="Release the pressure you normally contain." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_262"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_266" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_262"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_267" value="Push every adjacent unit 1 cardinal tile away from&#10;you if legal, including allies. Deals no damage. All&#10;destinations are checked before moving anyone." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_262"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_268" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="3414.9499999999994" width="361.6666666666667" height="227.75" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_269" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#91521d;strokeColor=#91521d;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="3414.9499999999994" width="5" height="227.75" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_270" value="Overchannel [Free; 1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#91521d;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_268"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_271" value="Demand one final effort from your body." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="kharazad-arms-15_panel_268"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_272" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="kharazad-arms-15_panel_268"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_273" value="After your normal action, take one extra action:&#10;move up to 2 tiles OR make a melee attack. Then&#10;lose 20% current HP, rounded up but never below 1,&#10;and cannot counter until next activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="kharazad-arms-15_panel_268"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="81.60000000000001" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_274" value="MECHANICAL CONTRACT / FIRST-PASS PROPOSAL" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=20;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="3703.149999999999" width="2300" height="33.0" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_275" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f4e7ce;strokeColor=#f4e7ce;" vertex="1" parent="1"><mxGeometry x="40" y="3751.149999999999" width="2300" height="102.8" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_276" value="Kharazad rulings" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="3763.149999999999" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_277" value="All martial paths express internal magic through bodily skill rather than conventional spell lists. Channeling statuses are magical; weapon wounds, combat stances and morale effects are not. A learned weapon-specific skill still requires that weapon, while discipline choices can support different martial equipment. Wait replacements are mutually exclusive: choose one each&#10;activation, then apply compatible on-Wait passives. Entry reactions check legal range and hostility as a unit enters a tile; misses do not stop movement unless the skill explicitly says otherwise." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="3795.149999999999" width="2264" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_278" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f4e7ce;strokeColor=#f4e7ce;" vertex="1" parent="1"><mxGeometry x="40" y="3873.9499999999994" width="2300" height="121.69999999999999" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_279" value="Action and timing" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="3885.9499999999994" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_280" value="First-pass design proposal, not an implementation claim. Numbers are starting balance values. One normal activation per unit each player phase: move, then one Action (attack, support, item or Wait). Actions end normal movement unless stated otherwise. Free and Mode skills do not spend that action. A round is one player phase plus one enemy phase; 1/round uses&#10;reset at player-phase start. Map uses reset only on a new battle or restart. Durations measured in target activations count the next N activation starts after application and end after the last such activation; a regeneration tick occurs at each counted start. An effect ending at your next activation expires before your movement; an effect ending at activation end may be&#10;used during it." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="3917.9499999999994" width="2264" height="62.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_281" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f4e7ce;strokeColor=#f4e7ce;" vertex="1" parent="1"><mxGeometry x="40" y="4015.649999999999" width="2300" height="102.8" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_282" value="Combat and movement" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="4027.649999999999" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_283" value="An attack skill replaces the normal attack and uses normal hit, block, crit, counter and speed follow-up rules unless stated. One opening strike per initiated exchange; an ordinary melee strike uses Str + might vs Def, magic uses Mag + might vs Res. A single magical skill strike without listed Hit uses 85 Hit and no speed follow-up. Prevention of a counter also prevents&#10;defender follow-up and Riposte. All distances and adjacency are cardinal Manhattan distance. Movement must follow a walkable path with normal terrain costs unless stated; swaps and pushes require legal destinations. Bonus movement is not a new activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="4059.649999999999" width="2264" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_284" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f4e7ce;strokeColor=#f4e7ce;" vertex="1" parent="1"><mxGeometry x="40" y="4138.449999999999" width="2300" height="121.69999999999999" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_285" value="Stacking and reactions" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="4150.449999999999" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_286" value="Hit, Crit, Block and Avoid bonuses are percentage points. Round down fractional damage/healing unless specified; HP stays between 0 and maximum. Apply percentage damage changes to resolved strike damage after mitigation/block, before HP loss. Outgoing skill damage scalars multiply with the strongest applicable incoming damage reduction; multiple incoming&#10;reductions do not stack. Same-name bonuses refresh; different named stat bonuses stack, but each movement trigger grants a choice of one bonus move per exchange/action. Generated splash, turret, Husk and reaction strikes do not trigger additional skills unless explicitly stated. Death bookkeeping still runs; kills by a controlled Husk or turret credit the owner with&#10;normal killer XP. Temporary units themselves award no XP when destroyed. A defeated caster loses auras immediately, but already applied timed statuses expire normally. One interception per exchange; controller chooses among eligible defenders. Resolve displacement after combat, never midway through its strike order." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="4182.449999999999" width="2264" height="62.7" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_panel_287" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f4e7ce;strokeColor=#f4e7ce;" vertex="1" parent="1"><mxGeometry x="40" y="4280.149999999999" width="2300" height="102.8" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_288" value="Status and content boundaries" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#91521d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="4292.149999999999" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="kharazad-arms-15_text_289" value="Pinned: -2 Move, minimum 1. Shaken: -15 Hit. Exposed: -3 Def and -3 Res. Bleed: lose 3 HP at each of the next 2 activation starts; can kill. Stat penalties never reduce Move below 1 unless explicitly 0. A target can hold one named body enhancement; replacing it does not erase owed penalties. Healing cannot revive; life-saving wards do not stack, and only one is&#10;consumed on a lethal strike. Proposed hooks include active skills, timed statuses, orders, entry reactions and temporary units; implement those hooks before shipping these definitions. These pages do not alter Mihata or grant new permanent campaign systems." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="4324.149999999999" width="2264" height="43.800000000000004" as="geometry" /></mxCell></root></mxGraphModel></diagram>
</mxfile>