  <diagram id="velvet19" name="Velvet Lantern"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="4246" math="0" shadow="0" background="#f7f4ee"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="velvet19_panel_1" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1660" height="12" as="geometry" /></mxCell><mxCell id="velvet19_text_2" value="VELVET LANTERN / THE HOUSE HAS TEETH" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=32;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="35" width="1580" height="49.2" as="geometry" /></mxCell><mxCell id="velvet19_text_3" value="Confirmed direction: Maid — defense or assassination. Courtesan — healing, buffing or debuffing. Synthesis — three cultures combined, generally ranged." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="92.2" width="1580" height="27.6" as="geometry" /></mxCell><mxCell id="velvet19_panel_4" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#eee0e7;strokeColor=#eee0e7;" vertex="1" parent="1"><mxGeometry x="40" y="131.8" width="1580" height="102.8" as="geometry" /></mxCell><mxCell id="velvet19_text_5" value="Build direction — proposal for review" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="143.8" width="1544" height="27.6" as="geometry" /></mxCell><mxCell id="velvet19_text_6" value="Follow one connected promotion path. Each class contributes the two skills printed on its card; keep learned ancestor skills, with explicit upgrades replacing earlier versions. No attribute gates are proposed. Six separate discipline choices allow personal&#10;variation; choose one per numbered column, two per tier. Unlock levels, point costs, respec rules and exact balance still need confirmation. This proposal does not change the implemented class-selection system." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="175.8" width="1544" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_text_7" value="MAID" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=24;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="274.6" width="1580" height="38.400000000000006" as="geometry" /></mxCell><mxCell id="velvet19_text_8" value="Keep the house safe. Smile, assess the room, then decide who is allowed near your people." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=15;fontColor=#202b30;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="316.0" width="1580" height="26.25" as="geometry" /></mxCell><mxCell id="velvet19_text_9" value="DISCIPLINE" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="357.25" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="velvet19_text_10" value="SPECIALIZATION" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="357.25" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="velvet19_text_11" value="MASTERY" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="357.25" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="velvet19_panel_12" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="600" y="389.25" width="440" height="310.45" as="geometry" /></mxCell><mxCell id="velvet19_panel_13" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="600" y="389.25" width="5" height="310.45" as="geometry" /></mxCell><mxCell id="velvet19_text_14" value="House Guardian" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet19_panel_12"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="velvet19_text_15" value="You will have to go through me. Protect through positioning,&#10;not just armor." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet19_panel_12"><mxGeometry x="18" y="56.35" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_text_16" value="Interpose [Reaction; 1/round]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_12"><mxGeometry x="18" y="107.15" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_17" value="Before a single-target attack on an adjacent ally, optionally swap&#10;places and become its defender. Requires legal tiles; one&#10;interception per exchange." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_12"><mxGeometry x="18" y="139.05" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="velvet19_text_18" value="Steady Hands [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_12"><mxGeometry x="18" y="208.75" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_19" value="After Interpose, take 30% less strike damage for that exchange.&#10;Works with any equipped weapon, including a bow." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_12"><mxGeometry x="18" y="240.65" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_panel_20" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1140" y="389.25" width="440" height="329.34999999999997" as="geometry" /></mxCell><mxCell id="velvet19_panel_21" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="1140" y="389.25" width="5" height="329.34999999999997" as="geometry" /></mxCell><mxCell id="velvet19_text_22" value="Head Maid" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet19_panel_20"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="velvet19_text_23" value="This room is under my care. Direct safe movement and deny an&#10;intruder the doorway." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet19_panel_20"><mxGeometry x="18" y="56.35" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_text_24" value="House Orders [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_20"><mxGeometry x="18" y="107.15" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_25" value="Choose an ally within 3 tiles. Move them up to 2 legal tiles now,&#10;without spending their activation. They gain +3 Def and +3 Res&#10;until your next activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_20"><mxGeometry x="18" y="139.05" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="velvet19_text_26" value="Not Another Step [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_20"><mxGeometry x="18" y="208.75" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_27" value="Choose 2 adjacent walkable tiles. Until your next activation, the&#10;first enemy entering either tile stops moving and deals 25% less&#10;strike damage that round." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_20"><mxGeometry x="18" y="240.65" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="velvet19_edge_28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#743952;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="velvet19_panel_12" target="velvet19_panel_20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="velvet19_panel_29" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="600" y="742.5999999999999" width="440" height="310.45" as="geometry" /></mxCell><mxCell id="velvet19_panel_30" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="600" y="742.5999999999999" width="5" height="310.45" as="geometry" /></mxCell><mxCell id="velvet19_text_31" value="Parlor Blade" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet19_panel_29"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="velvet19_text_32" value="Sweet service becomes a sudden knife. Attack someone whose&#10;attention is elsewhere." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet19_panel_29"><mxGeometry x="18" y="56.35" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_text_33" value="Hidden Dagger [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_29"><mxGeometry x="18" y="107.15" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_34" value="Use a carried dagger for a range-1 attack without changing your&#10;loadout. If the target is adjacent to another living ally of yours,&#10;your opening strike gains +20 Hit and cannot be countered." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_29"><mxGeometry x="18" y="139.05" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="velvet19_text_35" value="Slip Away [After combat; 1/activation]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_29"><mxGeometry x="18" y="208.75" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_36" value="After initiating dagger combat, move up to 2 legal tiles. You gain&#10;no new action; this is a separate movement grant." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_29"><mxGeometry x="18" y="240.65" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_panel_37" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1140" y="742.5999999999999" width="440" height="310.45000000000005" as="geometry" /></mxCell><mxCell id="velvet19_panel_38" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="1140" y="742.5999999999999" width="5" height="310.45000000000005" as="geometry" /></mxCell><mxCell id="velvet19_text_39" value="Velvet Assassin" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet19_panel_37"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="velvet19_text_40" value="One quiet opening, one precise cut, then back into the crowd." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet19_panel_37"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_41" value="Behind the Smile [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_37"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_42" value="Your opening dagger strike ignores 30% of Def when the target&#10;is adjacent to another ally of yours. Applies to Hidden Dagger; no&#10;facing system required." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_37"><mxGeometry x="18" y="120.15" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="velvet19_text_43" value="Curtain Call [Action; 1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_37"><mxGeometry x="18" y="189.85000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_44" value="Attack at range 1 with a carried dagger. Opening strike gains +25&#10;Crit; if the target is distracted as above, it cannot counter. After&#10;combat, move up to 3 tiles even if it survives." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_37"><mxGeometry x="18" y="221.75000000000003" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="velvet19_edge_45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#743952;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="velvet19_panel_29" target="velvet19_panel_37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="velvet19_panel_46" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="60" y="565.925" width="440" height="310.45000000000005" as="geometry" /></mxCell><mxCell id="velvet19_panel_47" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="60" y="565.925" width="5" height="310.45000000000005" as="geometry" /></mxCell><mxCell id="velvet19_text_48" value="Maid" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet19_panel_46"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="velvet19_text_49" value="A reassuring presence with a weapon within reach. Bow, sword,&#10;shield and dagger remain valid builds." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet19_panel_46"><mxGeometry x="18" y="56.35" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_text_50" value="At Your Side [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_46"><mxGeometry x="18" y="107.15" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_51" value="Swap with an adjacent ally if both tiles are legal. That ally takes&#10;25% less damage from the next strike before your next activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_46"><mxGeometry x="18" y="139.05" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_text_52" value="Quiet Readiness [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_46"><mxGeometry x="18" y="189.85000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_53" value="After Wait, choose Poised or Watchful until your next activation&#10;ends. Poised: +15 Hit on your next dagger strike. Watchful: +15&#10;Block with a shield." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_46"><mxGeometry x="18" y="221.75000000000003" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="velvet19_edge_54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#743952;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="velvet19_panel_46" target="velvet19_panel_12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="velvet19_edge_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#743952;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="velvet19_panel_46" target="velvet19_panel_29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="velvet19_text_56" value="COURTESAN" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=24;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1121.05" width="1580" height="38.400000000000006" as="geometry" /></mxCell><mxCell id="velvet19_text_57" value="Read what people need: comfort, courage, or a reason to doubt themselves." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=15;fontColor=#202b30;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1162.45" width="1580" height="26.25" as="geometry" /></mxCell><mxCell id="velvet19_text_58" value="DISCIPLINE" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1203.7" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="velvet19_text_59" value="SPECIALIZATION" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="1203.7" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="velvet19_text_60" value="MASTERY" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="1203.7" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="velvet19_panel_61" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="600" y="1235.7" width="440" height="291.55" as="geometry" /></mxCell><mxCell id="velvet19_panel_62" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="600" y="1235.7" width="5" height="291.55" as="geometry" /></mxCell><mxCell id="velvet19_text_63" value="Confidante" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet19_panel_61"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="velvet19_text_64" value="Stay with me. Keep a wounded companion calm enough to&#10;survive." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet19_panel_61"><mxGeometry x="18" y="56.35" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_text_65" value="Soothing Voice [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_61"><mxGeometry x="18" y="107.15" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_66" value="Heal one ally at range 1-2 for 8 + floor(Mag/2) HP and remove&#10;either Bleed or Shaken. Choose the removed status." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_61"><mxGeometry x="18" y="139.05" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_text_67" value="Safe in Your Hands [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_61"><mxGeometry x="18" y="189.85000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_68" value="Your healing gives its target +2 Def and +2 Res until your next&#10;activation. Refreshes; does not stack with itself." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_61"><mxGeometry x="18" y="221.75000000000003" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_panel_69" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1140" y="1235.7" width="440" height="291.55" as="geometry" /></mxCell><mxCell id="velvet19_panel_70" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="1140" y="1235.7" width="5" height="291.55" as="geometry" /></mxCell><mxCell id="velvet19_text_71" value="Heartkeeper" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet19_panel_69"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="velvet19_text_72" value="Nobody is left alone in their worst moment." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet19_panel_69"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_73" value="Shared Solace [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_69"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_74" value="Heal up to 3 allies within 2 tiles for 6 + floor(Mag/2) HP each.&#10;May include self; choose all recipients before resolution." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_69"><mxGeometry x="18" y="120.15" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_text_75" value="Stay With Me [Action; 1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_69"><mxGeometry x="18" y="170.95000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_76" value="Heal an ally within 2 tiles for 10 + Mag HP, then ward them until&#10;your next activation: their next lethal strike leaves them at 1 HP&#10;and consumes the ward." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_69"><mxGeometry x="18" y="202.85000000000002" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="velvet19_edge_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#743952;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="velvet19_panel_61" target="velvet19_panel_69"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="velvet19_panel_78" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="600" y="1551.25" width="440" height="291.55" as="geometry" /></mxCell><mxCell id="velvet19_panel_79" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="600" y="1551.25" width="5" height="291.55" as="geometry" /></mxCell><mxCell id="velvet19_text_80" value="Dancer" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet19_panel_78"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="velvet19_text_81" value="Set the rhythm. Turn a cautious ally into the person who takes&#10;the opening." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet19_panel_78"><mxGeometry x="18" y="56.35" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_text_82" value="Lead the Dance [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_78"><mxGeometry x="18" y="107.15" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_83" value="Move one adjacent ally up to 2 legal tiles without spending their&#10;activation. They gain +10 Hit until your next activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_78"><mxGeometry x="18" y="139.05" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_text_84" value="Rising Tempo [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_78"><mxGeometry x="18" y="189.85000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_85" value="An ally moved by Lead the Dance gains +2 attack power on their&#10;next initiated combat before your next activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_78"><mxGeometry x="18" y="221.75000000000003" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_panel_86" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1140" y="1551.25" width="440" height="291.55" as="geometry" /></mxCell><mxCell id="velvet19_panel_87" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="1140" y="1551.25" width="5" height="291.55" as="geometry" /></mxCell><mxCell id="velvet19_text_88" value="Prima" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet19_panel_86"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="velvet19_text_89" value="Make the whole formation move to your rhythm." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet19_panel_86"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_90" value="Grand Performance [Action; 1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_86"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_91" value="Choose up to 3 allies within 3 tiles. Each may move up to 2 tiles&#10;now, in a chosen order. Does not restore attack or item actions." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_86"><mxGeometry x="18" y="120.15" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_text_92" value="Crescendo [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_86"><mxGeometry x="18" y="170.95000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_93" value="Allies moved by your class skills gain +15 Hit and +3 attack&#10;power on their next initiated combat. Replaces Rising Tempo and&#10;Lead the Dance hit bonus." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_86"><mxGeometry x="18" y="202.85000000000002" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="velvet19_edge_94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#743952;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="velvet19_panel_78" target="velvet19_panel_86"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="velvet19_panel_95" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="600" y="1866.8" width="440" height="310.45" as="geometry" /></mxCell><mxCell id="velvet19_panel_96" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="600" y="1866.8" width="5" height="310.45" as="geometry" /></mxCell><mxCell id="velvet19_text_97" value="Temptress" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet19_panel_95"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="velvet19_text_98" value="A smile that makes the enemy hesitate at exactly the wrong&#10;time." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet19_panel_95"><mxGeometry x="18" y="56.35" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_text_99" value="Bait [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_95"><mxGeometry x="18" y="107.15" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_100" value="Mark one visible enemy within 3 tiles until your next activation. It&#10;has -20 Hit when attacking anyone except you. Does not force AI&#10;movement." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_95"><mxGeometry x="18" y="139.05" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="velvet19_text_101" value="Cold Shoulder [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_95"><mxGeometry x="18" y="208.75" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_102" value="The first time your Baited target enters an adjacent tile, end its&#10;movement and consume Bait. Its attack action remains available." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_95"><mxGeometry x="18" y="240.65" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_panel_103" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1140" y="1866.8" width="440" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="velvet19_panel_104" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="1140" y="1866.8" width="5" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="velvet19_text_105" value="Velvet Siren" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet19_panel_103"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="velvet19_text_106" value="Control the room by making every hostile choice uncomfortable." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet19_panel_103"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_107" value="Unravel [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_103"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_108" value="One visible enemy within 3 tiles becomes Shaken and Exposed&#10;until your next activation: -15 Hit and -3 Def/-3 Res." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_103"><mxGeometry x="18" y="120.15" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_text_109" value="No Composure [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_103"><mxGeometry x="18" y="170.95000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_110" value="Enemies currently Baited or Shaken by you cannot make a speed&#10;follow-up. Ordinary counters remain possible." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_103"><mxGeometry x="18" y="202.85000000000002" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_edge_111" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#743952;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="velvet19_panel_95" target="velvet19_panel_103"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="velvet19_panel_112" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="60" y="1570.15" width="440" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="velvet19_panel_113" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="60" y="1570.15" width="5" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="velvet19_text_114" value="Courtesan" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet19_panel_112"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="velvet19_text_115" value="A social presence with real battlefield influence. Healing,&#10;encouragement and hostile misdirection." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet19_panel_112"><mxGeometry x="18" y="56.35" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_text_116" value="Reassuring Touch [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_112"><mxGeometry x="18" y="107.15" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_117" value="Heal an adjacent ally for 6 + floor(Mag/2) HP. Cannot target self." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_112"><mxGeometry x="18" y="139.05" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_118" value="Graceful Exit [After support; 1/activation]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_112"><mxGeometry x="18" y="170.95000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_119" value="After using a healing, buff or debuff action, move 1 legal tile. This&#10;does not restore your action." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_112"><mxGeometry x="18" y="202.85000000000002" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_edge_120" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#743952;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="velvet19_panel_112" target="velvet19_panel_61"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="velvet19_edge_121" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#743952;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="velvet19_panel_112" target="velvet19_panel_78"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="velvet19_edge_122" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#743952;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="velvet19_panel_112" target="velvet19_panel_95"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="velvet19_text_123" value="SYNTHESIS" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=24;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="2245.25" width="1580" height="38.400000000000006" as="geometry" /></mxCell><mxCell id="velvet19_text_124" value="Three cultures, one practiced technique. These are usually ranged combatants, not three unrelated modules." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=15;fontColor=#202b30;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="2286.65" width="1580" height="26.25" as="geometry" /></mxCell><mxCell id="velvet19_text_125" value="DISCIPLINE" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="2327.9" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="velvet19_text_126" value="SPECIALIZATION" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="2327.9" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="velvet19_text_127" value="MASTERY" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="2327.9" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="velvet19_panel_128" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="600" y="2359.9" width="440" height="310.45" as="geometry" /></mxCell><mxCell id="velvet19_panel_129" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="600" y="2359.9" width="5" height="310.45" as="geometry" /></mxCell><mxCell id="velvet19_text_130" value="Silkshot" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet19_panel_128"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="velvet19_text_131" value="A steady hand, a tuned sight and a pulse of inner magic.&#10;Precision without brute force." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet19_panel_128"><mxGeometry x="18" y="56.35" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_text_132" value="Needle Round [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_128"><mxGeometry x="18" y="107.15" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_133" value="Make a bow/firearm attack at normal range with -25% strike&#10;damage. A damaging opening hit applies Pinned until your next&#10;activation: -2 Move, minimum 1." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_128"><mxGeometry x="18" y="139.05" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="velvet19_text_134" value="Living Sight [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_128"><mxGeometry x="18" y="208.75" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_135" value="Your attacks gain +15 Hit against Pinned or Exposed targets. A&#10;trained eye and enhanced nerves finish what the device begins." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_128"><mxGeometry x="18" y="240.65" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_panel_136" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1140" y="2359.9" width="440" height="310.45" as="geometry" /></mxCell><mxCell id="velvet19_panel_137" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="1140" y="2359.9" width="5" height="310.45" as="geometry" /></mxCell><mxCell id="velvet19_text_138" value="Threadbinder" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet19_panel_136"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="velvet19_text_139" value="Pin a threat in place and draw a precise line through its&#10;defenses." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet19_panel_136"><mxGeometry x="18" y="56.35" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_text_140" value="Thread the Needle [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_136"><mxGeometry x="18" y="107.15" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_141" value="Bow/firearm attack at normal range. Against Pinned or Exposed&#10;targets, the opening strike ignores 40% of the relevant Def or&#10;Res." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_136"><mxGeometry x="18" y="139.05" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="velvet19_text_142" value="Recoil Step [After combat; 1/activation]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_136"><mxGeometry x="18" y="208.75" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_143" value="After initiating ranged combat, move 1 legal tile. This never&#10;restores an attack." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_136"><mxGeometry x="18" y="240.65" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_edge_144" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#743952;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="velvet19_panel_128" target="velvet19_panel_136"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="velvet19_panel_145" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="600" y="2694.35" width="440" height="291.55" as="geometry" /></mxCell><mxCell id="velvet19_panel_146" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="600" y="2694.35" width="5" height="291.55" as="geometry" /></mxCell><mxCell id="velvet19_text_147" value="Ward Weaver" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet19_panel_145"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="velvet19_text_148" value="Project the protection your body cannot provide alone." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet19_panel_145"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_149" value="Woven Ward [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_145"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_150" value="Give an ally within 3 tiles a ward that reduces the next strike&#10;damage by 40%. Expires at your next activation; identical wards&#10;refresh." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_145"><mxGeometry x="18" y="120.15" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="velvet19_text_151" value="Restorative Filament [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_145"><mxGeometry x="18" y="189.85000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_152" value="When your Woven Ward is consumed by a surviving ally, heal&#10;them for 4 + floor(Mag/3) HP after the exchange." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_145"><mxGeometry x="18" y="221.75000000000003" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_panel_153" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1140" y="2694.35" width="440" height="291.55" as="geometry" /></mxCell><mxCell id="velvet19_panel_154" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="1140" y="2694.35" width="5" height="291.55" as="geometry" /></mxCell><mxCell id="velvet19_text_155" value="Lantern Aegis" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet19_panel_153"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="velvet19_text_156" value="A network of light keeps the household standing." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet19_panel_153"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_157" value="Sheltering Lights [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_153"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_158" value="Apply Woven Ward to up to 3 allies within 3 tiles, including self if&#10;chosen. Each ward has its own one-hit use." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_153"><mxGeometry x="18" y="120.15" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_text_159" value="Return the Pressure [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_153"><mxGeometry x="18" y="170.95000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_160" value="The first time one of your wards is consumed each round, gain&#10;+3 attack power for your next Channelled Shot before your next&#10;activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_153"><mxGeometry x="18" y="202.85000000000002" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="velvet19_edge_161" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#743952;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="velvet19_panel_145" target="velvet19_panel_153"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="velvet19_panel_162" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="600" y="3009.9" width="440" height="329.34999999999997" as="geometry" /></mxCell><mxCell id="velvet19_panel_163" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="600" y="3009.9" width="5" height="329.34999999999997" as="geometry" /></mxCell><mxCell id="velvet19_text_164" value="Essence Gunner" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet19_panel_162"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="velvet19_text_165" value="Bottle a biological effect, propel it with engineering, guide it&#10;with magic." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet19_panel_162"><mxGeometry x="18" y="56.35" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_text_166" value="Catalyst Dart [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_162"><mxGeometry x="18" y="107.15" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_167" value="Choose one visible enemy within 3 tiles. Make one magical strike&#10;with power Mag + 4 against Res. A damaging hit applies Exposed&#10;until your next activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_162"><mxGeometry x="18" y="139.05" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="velvet19_text_168" value="Measured Formula [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_162"><mxGeometry x="18" y="208.75" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_169" value="After Catalyst Dart hits, your next Channelled Shot against that&#10;target before the end of your next activation gains +3 attack&#10;power." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_162"><mxGeometry x="18" y="240.65" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="velvet19_panel_170" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1140" y="3009.9" width="440" height="291.55" as="geometry" /></mxCell><mxCell id="velvet19_panel_171" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="1140" y="3009.9" width="5" height="291.55" as="geometry" /></mxCell><mxCell id="velvet19_text_172" value="Velvet Paragon" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet19_panel_170"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="velvet19_text_173" value="A debuff becomes the opening for a perfectly integrated shot." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet19_panel_170"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_174" value="Threefold Shot [Action; 1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_170"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_175" value="Make a Channelled Shot at normal weapon range. Opening strike&#10;gains +4 power, ignores 25% of mitigation and prevents the&#10;target countering if it is Exposed or Pinned." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_170"><mxGeometry x="18" y="120.15" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="velvet19_text_176" value="Closed Circuit [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_170"><mxGeometry x="18" y="189.85000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_177" value="After you initiate ranged combat against an Exposed or Pinned&#10;target, heal yourself for 4 HP, once per activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_170"><mxGeometry x="18" y="221.75000000000003" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_edge_178" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#743952;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="velvet19_panel_162" target="velvet19_panel_170"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="velvet19_panel_179" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="60" y="2684.9" width="440" height="329.34999999999997" as="geometry" /></mxCell><mxCell id="velvet19_panel_180" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="60" y="2684.9" width="5" height="329.34999999999997" as="geometry" /></mxCell><mxCell id="velvet19_text_181" value="Synthesis Adept" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet19_panel_179"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="velvet19_text_182" value="Blend Kharazad channeling, Veyrhold devices and Nerath&#10;enhancement into a ranged craft." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet19_panel_179"><mxGeometry x="18" y="56.35" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet19_text_183" value="Channelled Shot [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_179"><mxGeometry x="18" y="107.15" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_184" value="With a bow or firearm, attack within its normal range. Choose&#10;normal physical damage or magical damage using Mag +&#10;weapon might against Res." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_179"><mxGeometry x="18" y="139.05" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="velvet19_text_185" value="Reinforced Focus [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet19_panel_179"><mxGeometry x="18" y="208.75" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet19_text_186" value="If you have not moved this activation, your opening ranged strike&#10;gains +10 Hit. Forced movement before activation does not&#10;disqualify it." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet19_panel_179"><mxGeometry x="18" y="240.65" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="velvet19_edge_187" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#743952;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="velvet19_panel_179" target="velvet19_panel_128"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="velvet19_edge_188" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#743952;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="velvet19_panel_179" target="velvet19_panel_145"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="velvet19_edge_189" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#743952;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="velvet19_panel_179" target="velvet19_panel_162"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="velvet19_text_190" value="MECHANICAL CONTRACT / FIRST-PASS PROPOSAL" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=20;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="3403.25" width="1580" height="33.0" as="geometry" /></mxCell><mxCell id="velvet19_panel_191" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#eee0e7;strokeColor=#eee0e7;" vertex="1" parent="1"><mxGeometry x="40" y="3451.25" width="1580" height="121.69999999999999" as="geometry" /></mxCell><mxCell id="velvet19_text_192" value="Velvet rulings" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="3463.25" width="1544" height="27.6" as="geometry" /></mxCell><mxCell id="velvet19_text_193" value="Maid retains Bow/Sword/Shield/Dagger access; Sophie can begin with a bow and still become a Head Maid. A concealed-dagger action requires a carried owned dagger and uses its might, Hit, Crit and weight for your offensive strikes in that exchange,&#10;then returns to the prior loadout. It does not grant an extra attack. Distracted means adjacent to another living ally of the attacker; this represents an opening, not literal facing or invisibility. Courtesan healing and Synthesis status effects are magical;&#10;Courtesan social buffs/debuffs and Maid orders are not. Generally ranged does not forbid future melee Synthesis variants." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="3495.25" width="1544" height="62.7" as="geometry" /></mxCell><mxCell id="velvet19_panel_194" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#eee0e7;strokeColor=#eee0e7;" vertex="1" parent="1"><mxGeometry x="40" y="3592.95" width="1580" height="140.6" as="geometry" /></mxCell><mxCell id="velvet19_text_195" value="Action and timing" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="3604.95" width="1544" height="27.6" as="geometry" /></mxCell><mxCell id="velvet19_text_196" value="First-pass design proposal, not an implementation claim. Numbers are starting balance values. One normal activation per unit each player phase: move, then one Action (attack, support, item or Wait). Actions end normal movement unless stated&#10;otherwise. Free and Mode skills do not spend that action. A round is one player phase plus one enemy phase; 1/round uses reset at player-phase start. Map uses reset only on a new battle or restart. Durations measured in target activations count the&#10;next N activation starts after application and end after the last such activation; a regeneration tick occurs at each counted start. An effect ending at your next activation expires before your movement; an effect ending at activation end may be used&#10;during it." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="3636.95" width="1544" height="81.60000000000001" as="geometry" /></mxCell><mxCell id="velvet19_panel_197" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#eee0e7;strokeColor=#eee0e7;" vertex="1" parent="1"><mxGeometry x="40" y="3753.5499999999997" width="1580" height="121.69999999999999" as="geometry" /></mxCell><mxCell id="velvet19_text_198" value="Combat and movement" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="3765.5499999999997" width="1544" height="27.6" as="geometry" /></mxCell><mxCell id="velvet19_text_199" value="An attack skill replaces the normal attack and uses normal hit, block, crit, counter and speed follow-up rules unless stated. One opening strike per initiated exchange; an ordinary melee strike uses Str + might vs Def, magic uses Mag + might vs Res. A&#10;single magical skill strike without listed Hit uses 85 Hit and no speed follow-up. Prevention of a counter also prevents defender follow-up and Riposte. All distances and adjacency are cardinal Manhattan distance. Movement must follow a walkable path&#10;with normal terrain costs unless stated; swaps and pushes require legal destinations. Bonus movement is not a new activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="3797.5499999999997" width="1544" height="62.7" as="geometry" /></mxCell><mxCell id="velvet19_panel_200" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#eee0e7;strokeColor=#eee0e7;" vertex="1" parent="1"><mxGeometry x="40" y="3895.2499999999995" width="1580" height="159.5" as="geometry" /></mxCell><mxCell id="velvet19_text_201" value="Stacking and reactions" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="3907.2499999999995" width="1544" height="27.6" as="geometry" /></mxCell><mxCell id="velvet19_text_202" value="Hit, Crit, Block and Avoid bonuses are percentage points. Round down fractional damage/healing unless specified; HP stays between 0 and maximum. Apply percentage damage changes to resolved strike damage after mitigation/block, before HP loss.&#10;Outgoing skill damage scalars multiply with the strongest applicable incoming damage reduction; multiple incoming reductions do not stack. Same-name bonuses refresh; different named stat bonuses stack, but each movement trigger grants a choice&#10;of one bonus move per exchange/action. Generated splash, turret, Husk and reaction strikes do not trigger additional skills unless explicitly stated. Death bookkeeping still runs; kills by a controlled Husk or turret credit the owner with normal killer XP.&#10;Temporary units themselves award no XP when destroyed. A defeated caster loses auras immediately, but already applied timed statuses expire normally. One interception per exchange; controller chooses among eligible defenders. Resolve displacement&#10;after combat, never midway through its strike order." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="3939.2499999999995" width="1544" height="100.50000000000001" as="geometry" /></mxCell><mxCell id="velvet19_panel_203" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#eee0e7;strokeColor=#eee0e7;" vertex="1" parent="1"><mxGeometry x="40" y="4074.7499999999995" width="1580" height="121.69999999999999" as="geometry" /></mxCell><mxCell id="velvet19_text_204" value="Status and content boundaries" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="4086.7499999999995" width="1544" height="27.6" as="geometry" /></mxCell><mxCell id="velvet19_text_205" value="Pinned: -2 Move, minimum 1. Shaken: -15 Hit. Exposed: -3 Def and -3 Res. Bleed: lose 3 HP at each of the next 2 activation starts; can kill. Stat penalties never reduce Move below 1 unless explicitly 0. A target can hold one named body enhancement;&#10;replacing it does not erase owed penalties. Healing cannot revive; life-saving wards do not stack, and only one is consumed on a lethal strike. Proposed hooks include active skills, timed statuses, orders, entry reactions and temporary units; implement&#10;those hooks before shipping these definitions. These pages do not alter Mihata or grant new permanent campaign systems." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="4118.75" width="1544" height="62.7" as="geometry" /></mxCell></root></mxGraphModel></diagram>
  <diagram id="velvet-skills-19" name="Velvet Lantern Disciplines"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2380" pageHeight="2318" math="0" shadow="0" background="#f7f4ee"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="velvet-skills-19_panel_1" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2380" height="12" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_2" value="VELVET LANTERN / PERSONAL DISCIPLINES" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=32;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="35" width="2300" height="49.2" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_3" value="Choose the gestures that make this character feel like your Head Maid, hidden assassin, confidante or ranged synthesist." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="92.2" width="2300" height="27.6" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_4" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#eee0e7;strokeColor=#eee0e7;" vertex="1" parent="1"><mxGeometry x="40" y="131.8" width="2300" height="102.8" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_5" value="Six choices, one character" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="143.8" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_6" value="Choose exactly one skill from each numbered column, two per tier. Mix rows freely within this board; no prior skill in the same row is required. A skill naming another technique includes that technique only when explicitly stated. Equipment requirements still apply. Class signature skills come from the separate promotion tree. Values and progression economy are&#10;first-pass proposals." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="175.8" width="2264" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_7" value="CHOICE 1 / TIER 1" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60.0" y="266.6" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_8" value="CHOICE 2 / TIER 1" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="266.6" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_9" value="CHOICE 3 / TIER 2" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="266.6" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_10" value="CHOICE 4 / TIER 2" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1199.0" y="266.6" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_11" value="CHOICE 5 / TIER 3" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="266.6" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_12" value="CHOICE 6 / TIER 3" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="266.6" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_13" value="MAID / DEFENSE" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=22;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="302.6" width="2260" height="35.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_14" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="60.0" y="350.3" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_15" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="60.0" y="350.3" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_16" value="Mind the Step [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_14"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_17" value="Guide someone out of trouble." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_14"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_18" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_14"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_19" value="Move an adjacent ally 1 legal tile. They take 25% less&#10;damage from their next strike before your next&#10;activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_14"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_20" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="350.3" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_21" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="350.3" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_22" value="Ready Shield [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_20"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_23" value="Prepared, not naturally invulnerable." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_20"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_24" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_20"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_25" value="With a shield equipped, gain +15 Block during an&#10;exchange initiated by an enemy adjacent to one of&#10;your other allies." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_20"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_26" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="350.3" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_27" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="350.3" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_28" value="Clear the Door [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_26"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_29" value="Make room for your charge." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_26"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_30" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_26"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_31" value="Make a melee attack with 25% less strike damage.&#10;On a damaging opening hit, push the target 1 tile&#10;after combat if legal." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_26"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_32" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1199.0" y="350.3" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_33" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="1199.0" y="350.3" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_34" value="Take Cover [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_32"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_35" value="A small gesture saves a life." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_32"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_36" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_32"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_37" value="An ally within 2 tiles takes 35% less strike damage&#10;until your next activation while it remains on its&#10;current tile. Moving ends the effect." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_32"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_38" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="350.3" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_39" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="350.3" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_40" value="Firm Refusal [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_38"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_41" value="They cannot simply drag you aside." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_38"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_42" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_38"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_43" value="After Wait, you cannot be pushed or pulled until&#10;your next activation. Adjacent allies gain the same&#10;immunity while adjacent." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_38"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_44" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="350.3" width="361.6666666666667" height="237.2" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_45" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="350.3" width="5" height="237.2" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_46" value="Everyone Behind Me [Action;&#10;1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_44"><mxGeometry x="18" y="15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_47" value="Gather the household behind its protector." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_44"><mxGeometry x="18" y="84.7" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_48" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_44"><mxGeometry x="18" y="116.60000000000001" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_49" value="Choose up to 2 allies within 2 tiles. Each may move&#10;up to 2 legal tiles, ending adjacent to you; both take&#10;40% less strike damage until your next activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_44"><mxGeometry x="18" y="148.5" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_50" value="MAID / ASSASSINATION" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=22;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="622.5" width="2260" height="35.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_51" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="60.0" y="670.2" width="361.6666666666667" height="189.95000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_52" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="60.0" y="670.2" width="5" height="189.95000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_53" value="Innocent Approach [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_51"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_54" value="Look harmless until the blade is close." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_51"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_55" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_51"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_56" value="Your opening dagger strike gains +15 Hit against a&#10;target at full HP." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_51"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_57" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="670.2" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_58" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="670.2" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_59" value="Sleeve Knife [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_57"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_60" value="A concealed blade changes the conversation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_57"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_61" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_57"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_62" value="Attack at range 1 using a carried dagger without&#10;changing equipped gear. Gain +2 power on the&#10;opening strike. Requires an owned dagger." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_57"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_63" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="670.2" width="361.6666666666667" height="189.95000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_64" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="670.2" width="5" height="189.95000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_65" value="Divided Attention [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_63"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_66" value="Strike while someone else holds their gaze." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_63"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_67" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_63"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_68" value="Your opening dagger strike gains +15 Crit if the&#10;target is adjacent to another living ally of yours." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_63"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_69" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1199.0" y="670.2" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_70" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="1199.0" y="670.2" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_71" value="Cut the Tendon [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_69"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_72" value="Leave the pursuer unable to keep up." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_69"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_73" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_69"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_74" value="Make a dagger attack with 25% less strike damage.&#10;A damaging opening hit applies Pinned until your&#10;next activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_69"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_75" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="670.2" width="361.6666666666667" height="237.2" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_76" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="670.2" width="5" height="237.2" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_77" value="Back Through the Crowd [After&#10;combat; 1/activation]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_75"><mxGeometry x="18" y="15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_78" value="Disappear behind familiar faces." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_75"><mxGeometry x="18" y="84.7" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_79" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_75"><mxGeometry x="18" y="116.60000000000001" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_80" value="After initiating dagger combat, swap with an&#10;adjacent ally if both tiles are legal. Grants neither&#10;unit another action." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_75"><mxGeometry x="18" y="148.5" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_81" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="670.2" width="361.6666666666667" height="237.2" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_82" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="670.2" width="5" height="237.2" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_83" value="No Witness to the Draw [Action;&#10;1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_81"><mxGeometry x="18" y="15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_84" value="The concealed strike arrives before resistance." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_81"><mxGeometry x="18" y="84.7" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_85" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_81"><mxGeometry x="18" y="116.60000000000001" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_86" value="Use a carried dagger at range 1. The enemy cannot&#10;counter this exchange. After combat, move up to 2&#10;legal tiles; no new action." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_81"><mxGeometry x="18" y="148.5" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_87" value="COURTESAN" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=22;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="942.4000000000001" width="2260" height="35.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_88" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="60.0" y="990.1000000000001" width="361.6666666666667" height="189.95000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_89" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="60.0" y="990.1000000000001" width="5" height="189.95000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_90" value="Comforting Touch [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_88"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_91" value="Restore confidence as well as breath." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_88"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_92" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_88"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_93" value="Heal an adjacent living ally for 6 + floor(Mag/2) HP.&#10;Remove Shaken if present." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_88"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_94" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="990.1000000000001" width="361.6666666666667" height="189.95000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_95" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="990.1000000000001" width="5" height="189.95000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_96" value="Words of Courage [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_94"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_97" value="Tell someone they can make the shot." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_94"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_98" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_94"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_99" value="An ally within 3 tiles gains +15 Hit for its next&#10;initiated combat before your next activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_94"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_100" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="990.1000000000001" width="361.6666666666667" height="189.95000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_101" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="990.1000000000001" width="5" height="189.95000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_102" value="A Cutting Remark [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_100"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_103" value="Make a dangerous enemy doubt its hand." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_100"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_104" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_100"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_105" value="One visible enemy within 3 tiles becomes Shaken&#10;until your next activation: -15 Hit." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_100"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_106" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1199.0" y="990.1000000000001" width="361.6666666666667" height="189.95000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_107" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="1199.0" y="990.1000000000001" width="5" height="189.95000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_108" value="Shared Breath [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_106"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_109" value="Give two companions a moment to recover." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_106"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_110" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_106"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_111" value="Heal up to 2 living allies within 2 tiles for 8 +&#10;floor(Mag/3) HP each. Cannot target self." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_106"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_112" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="990.1000000000001" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_113" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="990.1000000000001" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_114" value="Take Your Place [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_112"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_115" value="Invite an ally into the right position." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_112"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_116" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_112"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_117" value="Move an ally within 2 tiles up to 2 legal tiles. It gains&#10;+2 attack power for its next initiated combat before&#10;your next activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_112"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_118" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="990.1000000000001" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_119" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="990.1000000000001" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_120" value="Stolen Resolve [Action; 1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_118"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_121" value="One perfectly chosen phrase ruins the attack." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_118"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_122" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_118"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_123" value="One visible enemy within 3 tiles has -4 attack power&#10;and cannot make speed follow-ups until your next&#10;activation. Does not prevent its ordinary action." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_118"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_124" value="SYNTHESIS" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=22;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1233.9500000000003" width="2260" height="35.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_125" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="60.0" y="1281.6500000000003" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_126" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="60.0" y="1281.6500000000003" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_127" value="Attuned Projectile [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_125"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_128" value="An engineered shot carries internal magic." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_125"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_129" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_125"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_130" value="With a bow or firearm, make a normal-range attack&#10;using Mag + weapon might against Res instead of&#10;physical power and Def." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_125"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_131" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="1281.6500000000003" width="361.6666666666667" height="218.3" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_132" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="1281.6500000000003" width="5" height="218.3" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_133" value="Reflex Stitch [After combat;&#10;1/activation]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_131"><mxGeometry x="18" y="15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_134" value="Enhanced nerves catch the recoil." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_131"><mxGeometry x="18" y="84.7" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_135" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_131"><mxGeometry x="18" y="116.60000000000001" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_136" value="After initiating bow or firearm combat, move 1 legal&#10;tile. No extra action." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_131"><mxGeometry x="18" y="148.5" width="325.6666666666667" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_137" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="1281.6500000000003" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_138" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="1281.6500000000003" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_139" value="Disrupting Dart [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_137"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_140" value="A calibrated dose breaks concentration." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_137"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_141" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_137"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_142" value="Make one range-1-3 magical strike: power Mag + 3,&#10;Hit 85. A damaging hit suppresses one chosen&#10;positive magical status until your next activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_137"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_143" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1199.0" y="1281.6500000000003" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_144" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="1199.0" y="1281.6500000000003" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_145" value="Barrier Thread [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_143"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_146" value="Project a measured dose of protection." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_143"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_147" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_143"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_148" value="An ally within 3 tiles takes 40% less damage from its&#10;next strike before your next activation. Identical&#10;wards refresh." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_143"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_149" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="1281.6500000000003" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_150" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="1281.6500000000003" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_151" value="Predator Lens [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_149"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_152" value="Read the opening your allies created." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_149"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_153" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_149"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_154" value="Your opening bow/firearm strike gains +3 power&#10;against Pinned, Shaken or Exposed enemies. Only&#10;one bonus even with several statuses." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_149"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_155" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="1281.6500000000003" width="361.6666666666667" height="256.1" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_156" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#743952;strokeColor=#743952;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="1281.6500000000003" width="5" height="256.1" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_157" value="Concordant Volley [Action;&#10;1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#743952;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_155"><mxGeometry x="18" y="15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_158" value="All three disciplines become one deliberate shot." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="velvet-skills-19_panel_155"><mxGeometry x="18" y="84.7" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_159" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="velvet-skills-19_panel_155"><mxGeometry x="18" y="116.60000000000001" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_160" value="Make an Attuned Projectile attack, whether or not&#10;you learned that skill. Opening strike gains +4&#10;power; after combat heal an ally within 2 tiles for 8&#10;HP." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="velvet-skills-19_panel_155"><mxGeometry x="18" y="148.5" width="325.6666666666667" height="81.60000000000001" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_161" value="MECHANICAL CONTRACT / FIRST-PASS PROPOSAL" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=20;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1588.7500000000005" width="2300" height="33.0" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_162" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#eee0e7;strokeColor=#eee0e7;" vertex="1" parent="1"><mxGeometry x="40" y="1636.7500000000005" width="2300" height="102.8" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_163" value="Velvet rulings" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="1648.7500000000005" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_164" value="Maid retains Bow/Sword/Shield/Dagger access; Sophie can begin with a bow and still become a Head Maid. A concealed-dagger action requires a carried owned dagger and uses its might, Hit, Crit and weight for your offensive strikes in that exchange, then returns to the prior loadout. It does not grant an extra attack. Distracted means adjacent to another living ally of&#10;the attacker; this represents an opening, not literal facing or invisibility. Courtesan healing and Synthesis status effects are magical; Courtesan social buffs/debuffs and Maid orders are not. Generally ranged does not forbid future melee Synthesis variants." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="1680.7500000000005" width="2264" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_165" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#eee0e7;strokeColor=#eee0e7;" vertex="1" parent="1"><mxGeometry x="40" y="1759.5500000000004" width="2300" height="121.69999999999999" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_166" value="Action and timing" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="1771.5500000000004" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_167" value="First-pass design proposal, not an implementation claim. Numbers are starting balance values. One normal activation per unit each player phase: move, then one Action (attack, support, item or Wait). Actions end normal movement unless stated otherwise. Free and Mode skills do not spend that action. A round is one player phase plus one enemy phase; 1/round uses&#10;reset at player-phase start. Map uses reset only on a new battle or restart. Durations measured in target activations count the next N activation starts after application and end after the last such activation; a regeneration tick occurs at each counted start. An effect ending at your next activation expires before your movement; an effect ending at activation end may be&#10;used during it." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="1803.5500000000004" width="2264" height="62.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_168" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#eee0e7;strokeColor=#eee0e7;" vertex="1" parent="1"><mxGeometry x="40" y="1901.2500000000005" width="2300" height="102.8" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_169" value="Combat and movement" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="1913.2500000000005" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_170" value="An attack skill replaces the normal attack and uses normal hit, block, crit, counter and speed follow-up rules unless stated. One opening strike per initiated exchange; an ordinary melee strike uses Str + might vs Def, magic uses Mag + might vs Res. A single magical skill strike without listed Hit uses 85 Hit and no speed follow-up. Prevention of a counter also prevents&#10;defender follow-up and Riposte. All distances and adjacency are cardinal Manhattan distance. Movement must follow a walkable path with normal terrain costs unless stated; swaps and pushes require legal destinations. Bonus movement is not a new activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="1945.2500000000005" width="2264" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_171" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#eee0e7;strokeColor=#eee0e7;" vertex="1" parent="1"><mxGeometry x="40" y="2024.0500000000004" width="2300" height="121.69999999999999" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_172" value="Stacking and reactions" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="2036.0500000000004" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_173" value="Hit, Crit, Block and Avoid bonuses are percentage points. Round down fractional damage/healing unless specified; HP stays between 0 and maximum. Apply percentage damage changes to resolved strike damage after mitigation/block, before HP loss. Outgoing skill damage scalars multiply with the strongest applicable incoming damage reduction; multiple incoming&#10;reductions do not stack. Same-name bonuses refresh; different named stat bonuses stack, but each movement trigger grants a choice of one bonus move per exchange/action. Generated splash, turret, Husk and reaction strikes do not trigger additional skills unless explicitly stated. Death bookkeeping still runs; kills by a controlled Husk or turret credit the owner with&#10;normal killer XP. Temporary units themselves award no XP when destroyed. A defeated caster loses auras immediately, but already applied timed statuses expire normally. One interception per exchange; controller chooses among eligible defenders. Resolve displacement after combat, never midway through its strike order." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="2068.05" width="2264" height="62.7" as="geometry" /></mxCell><mxCell id="velvet-skills-19_panel_174" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#eee0e7;strokeColor=#eee0e7;" vertex="1" parent="1"><mxGeometry x="40" y="2165.7500000000005" width="2300" height="102.8" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_175" value="Status and content boundaries" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#743952;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="2177.7500000000005" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="velvet-skills-19_text_176" value="Pinned: -2 Move, minimum 1. Shaken: -15 Hit. Exposed: -3 Def and -3 Res. Bleed: lose 3 HP at each of the next 2 activation starts; can kill. Stat penalties never reduce Move below 1 unless explicitly 0. A target can hold one named body enhancement; replacing it does not erase owed penalties. Healing cannot revive; life-saving wards do not stack, and only one is&#10;consumed on a lethal strike. Proposed hooks include active skills, timed statuses, orders, entry reactions and temporary units; implement those hooks before shipping these definitions. These pages do not alter Mihata or grant new permanent campaign systems." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="2209.7500000000005" width="2264" height="43.800000000000004" as="geometry" /></mxCell></root></mxGraphModel></diagram>
  <diagram id="nerSkills17" name="Nerath Disciplines"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2380" pageHeight="2036" math="0" shadow="0" background="#f7f4ee"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="nerSkills17_panel_1" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2380" height="12" as="geometry" /></mxCell><mxCell id="nerSkills17_text_2" value="NERATH / PERSONAL DISCIPLINES" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=32;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="35" width="2300" height="49.2" as="geometry" /></mxCell><mxCell id="nerSkills17_text_3" value="Treatment, borrowed remnants and deliberate bodily change. Every choice has a use without an unrelated class prerequisite." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="92.2" width="2300" height="27.6" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_4" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dfede4;strokeColor=#dfede4;" vertex="1" parent="1"><mxGeometry x="40" y="131.8" width="2300" height="102.8" as="geometry" /></mxCell><mxCell id="nerSkills17_text_5" value="Six choices, one character" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="143.8" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="nerSkills17_text_6" value="Choose exactly one skill from each numbered column, two per tier. Mix rows freely within this board; no prior skill in the same row is required. A skill naming another technique includes that technique only when explicitly stated. Equipment requirements still apply. Class signature skills come from the separate promotion tree. Values and progression economy are&#10;first-pass proposals." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="175.8" width="2264" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="nerSkills17_text_7" value="CHOICE 1 / TIER 1" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60.0" y="266.6" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_8" value="CHOICE 2 / TIER 1" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="266.6" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_9" value="CHOICE 3 / TIER 2" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="266.6" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_10" value="CHOICE 4 / TIER 2" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1199.0" y="266.6" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_11" value="CHOICE 5 / TIER 3" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="266.6" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_12" value="CHOICE 6 / TIER 3" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="266.6" width="361.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_13" value="RESTORATION" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=22;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="302.6" width="2260" height="35.7" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_14" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="60.0" y="350.3" width="361.6666666666667" height="218.3" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_15" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="60.0" y="350.3" width="5" height="218.3" as="geometry" /></mxCell><mxCell id="nerSkills17_text_16" value="Triage Step [After heal;&#10;1/activation]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="nerSkills17_panel_14"><mxGeometry x="18" y="15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="nerSkills17_text_17" value="Move on only when the patient is stable." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="nerSkills17_panel_14"><mxGeometry x="18" y="84.7" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_18" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="nerSkills17_panel_14"><mxGeometry x="18" y="116.60000000000001" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_19" value="After healing a living ally that began below 50% HP,&#10;move 1 legal tile. Does not grant another action." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="nerSkills17_panel_14"><mxGeometry x="18" y="148.5" width="325.6666666666667" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_20" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="350.3" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_21" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="350.3" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_22" value="Purge [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="nerSkills17_panel_20"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="nerSkills17_text_23" value="Treat the condition that makes the wound recur." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="nerSkills17_panel_20"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_24" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="nerSkills17_panel_20"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_25" value="Remove one chosen Bleed, Pinned, Shaken or&#10;Exposed status from a living ally within 2 tiles; also&#10;heal 4 HP." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="nerSkills17_panel_20"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_26" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="350.3" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_27" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="350.3" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_28" value="Transfusion [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="nerSkills17_panel_26"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="nerSkills17_text_29" value="Take part of the burden into your own body." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="nerSkills17_panel_26"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_30" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="nerSkills17_panel_26"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_31" value="Pay 1-6 HP, never below 1, to heal a living ally&#10;within 2 tiles for twice the amount paid. Choose&#10;payment before confirming." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="nerSkills17_panel_26"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_32" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1199.0" y="350.3" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_33" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="1199.0" y="350.3" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_34" value="Regenerative Seal [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="nerSkills17_panel_32"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="nerSkills17_text_35" value="Invest in a recovery that takes time." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="nerSkills17_panel_32"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_36" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="nerSkills17_panel_32"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_37" value="A living ally within 2 tiles heals 6 HP at the start of&#10;each of its next 2 activations. Refreshing replaces&#10;remaining ticks." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="nerSkills17_panel_32"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_38" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="350.3" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_39" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="350.3" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_40" value="Protect the Patient [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="nerSkills17_panel_38"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="nerSkills17_text_41" value="Give treatment time to work." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="nerSkills17_panel_38"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_42" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="nerSkills17_panel_38"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_43" value="Your healing or regeneration skill grants +3 Def to&#10;its target until your next activation. Apply when&#10;casting, not on each tick." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="nerSkills17_panel_38"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_44" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="350.3" width="361.6666666666667" height="237.2" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_45" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="350.3" width="5" height="237.2" as="geometry" /></mxCell><mxCell id="nerSkills17_text_46" value="Miracle Procedure [Action;&#10;1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="nerSkills17_panel_44"><mxGeometry x="18" y="15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="nerSkills17_text_47" value="Make a costly intervention at the critical moment." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="nerSkills17_panel_44"><mxGeometry x="18" y="84.7" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_48" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="nerSkills17_panel_44"><mxGeometry x="18" y="116.60000000000001" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_49" value="Heal a living ally within 2 tiles to at least 70% max&#10;HP and remove Bleed, Pinned, Shaken and Exposed.&#10;You cannot counter until your next activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="nerSkills17_panel_44"><mxGeometry x="18" y="148.5" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="nerSkills17_text_50" value="DEATHCRAFT" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=22;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="622.5" width="2260" height="35.7" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_51" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="60.0" y="670.2" width="361.6666666666667" height="227.75" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_52" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="60.0" y="670.2" width="5" height="227.75" as="geometry" /></mxCell><mxCell id="nerSkills17_text_53" value="Funeral Reserve [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="nerSkills17_panel_51"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="nerSkills17_text_54" value="Carry one final kindness from the fallen." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="nerSkills17_panel_51"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_55" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="nerSkills17_panel_51"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_56" value="When a non-summoned living unit dies within 3&#10;tiles, store a Funeral token, maximum 1. Consume it&#10;on your next heal for +6 HP. Can trigger once per&#10;round." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="nerSkills17_panel_51"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="81.60000000000001" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_57" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="670.2" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_58" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="670.2" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_59" value="Bone Screen [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="nerSkills17_panel_57"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="nerSkills17_text_60" value="A corpse can still hold a doorway." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="nerSkills17_panel_57"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_61" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="nerSkills17_panel_57"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_62" value="Consume an enemy corpse within 2 tiles to place a&#10;15-HP, Def/Res 0 bone wall on its tile. Blocks&#10;walking, not line of sight; no wall on an occupied tile." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="nerSkills17_panel_57"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_63" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="670.2" width="361.6666666666667" height="237.2" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_64" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="670.2" width="5" height="237.2" as="geometry" /></mxCell><mxCell id="nerSkills17_text_65" value="Borrowed Breath [Action;&#10;2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="nerSkills17_panel_63"><mxGeometry x="18" y="15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="nerSkills17_text_66" value="Give up the body to help the living." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="nerSkills17_panel_63"><mxGeometry x="18" y="84.7" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_67" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="nerSkills17_panel_63"><mxGeometry x="18" y="116.60000000000001" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_68" value="Consume an enemy corpse within 3 tiles and heal&#10;one living ally within 2 tiles of that corpse for 10 HP.&#10;Select both before resolving." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="nerSkills17_panel_63"><mxGeometry x="18" y="148.5" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_69" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1199.0" y="670.2" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_70" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="1199.0" y="670.2" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_71" value="Grave Tether [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="nerSkills17_panel_69"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="nerSkills17_text_72" value="Make the injured feel the weight of the grave." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="nerSkills17_panel_69"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_73" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="nerSkills17_panel_69"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_74" value="One visible enemy within 3 tiles and below 50% HP&#10;becomes Pinned until your next activation. No&#10;corpse or servant required." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="nerSkills17_panel_69"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_75" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="670.2" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_76" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="670.2" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_77" value="Final Testimony [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="nerSkills17_panel_75"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="nerSkills17_text_78" value="A nearby death sharpens your next purpose." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="nerSkills17_panel_75"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_79" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="nerSkills17_panel_75"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_80" value="After a non-summoned living unit dies within 3 tiles,&#10;your next opening attack before your next activation&#10;ends gains +15 Hit. Refreshes; does not stack." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="nerSkills17_panel_75"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_81" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="670.2" width="361.6666666666667" height="246.65000000000003" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_82" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="670.2" width="5" height="246.65000000000003" as="geometry" /></mxCell><mxCell id="nerSkills17_text_83" value="Borrowed Hour [Action; 1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="nerSkills17_panel_81"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="nerSkills17_text_84" value="Offer the living one more chance, paid for by the&#10;dead." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="nerSkills17_panel_81"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="nerSkills17_text_85" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="nerSkills17_panel_81"><mxGeometry x="18" y="107.15" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_86" value="Consume an enemy corpse within 3 tiles. Ward one&#10;living ally within 2 tiles of it until your next&#10;activation: its next lethal strike leaves 1 HP and&#10;consumes the ward." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="nerSkills17_panel_81"><mxGeometry x="18" y="139.05" width="325.6666666666667" height="81.60000000000001" as="geometry" /></mxCell><mxCell id="nerSkills17_text_87" value="FLESHCRAFT" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=22;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="951.8500000000001" width="2260" height="35.7" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_88" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="60.0" y="999.5500000000002" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_89" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="60.0" y="999.5500000000002" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_90" value="Conditioned Body [Preparation]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="nerSkills17_panel_88"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="nerSkills17_text_91" value="Choose what this body has been trained to endure." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="nerSkills17_panel_88"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_92" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="nerSkills17_panel_88"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_93" value="Before each map choose +4 maximum HP (also +4&#10;starting HP, capped) or +2 Speed for that map. No&#10;permanent growth points." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="nerSkills17_panel_88"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_94" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="999.5500000000002" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_95" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="439.6666666666667" y="999.5500000000002" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_96" value="Adrenal Dose [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="nerSkills17_panel_94"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="nerSkills17_text_97" value="Borrow speed from tomorrow." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="nerSkills17_panel_94"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_98" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="nerSkills17_panel_94"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_99" value="One living ally within 2 tiles gains +1 Move for its&#10;next activation, then -1 Move during the following&#10;activation; minimum 1." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="nerSkills17_panel_94"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_100" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="999.5500000000002" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_101" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="819.3333333333334" y="999.5500000000002" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_102" value="Predatory Tissue [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="nerSkills17_panel_100"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="nerSkills17_text_103" value="Build a hunter that recovers through commitment." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="nerSkills17_panel_100"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_104" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="nerSkills17_panel_100"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_105" value="One living ally within 2 tiles heals 6 HP after its first&#10;kill each activation, for its next 2 activations.&#10;Occupies its body-enhancement slot." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="nerSkills17_panel_100"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_106" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1199.0" y="999.5500000000002" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_107" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="1199.0" y="999.5500000000002" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_108" value="Dermal Plating [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="nerSkills17_panel_106"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="nerSkills17_text_109" value="Trade flexibility for survival." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="nerSkills17_panel_106"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_110" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="nerSkills17_panel_106"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_111" value="One living ally within 2 tiles gains +4 Def and -2&#10;Speed until your next activation. Occupies its&#10;body-enhancement slot." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="nerSkills17_panel_106"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_112" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="999.5500000000002" width="361.6666666666667" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_113" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="1578.6666666666667" y="999.5500000000002" width="5" height="208.85000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_114" value="Reflex Graft [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="nerSkills17_panel_112"><mxGeometry x="18" y="15" width="325.6666666666667" height="34.35" as="geometry" /></mxCell><mxCell id="nerSkills17_text_115" value="A body prepared for the first incoming blow." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="nerSkills17_panel_112"><mxGeometry x="18" y="56.35" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_116" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="nerSkills17_panel_112"><mxGeometry x="18" y="88.25" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_117" value="One living ally within 2 tiles gains +20 Avoid against&#10;the next initiating strike before your next activation.&#10;Consumed on attempt; one graft at a time." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="nerSkills17_panel_112"><mxGeometry x="18" y="120.15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_118" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="999.5500000000002" width="361.6666666666667" height="256.1" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_119" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="1958.3333333333335" y="999.5500000000002" width="5" height="256.1" as="geometry" /></mxCell><mxCell id="nerSkills17_text_120" value="Perfected Mutation [Action;&#10;1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="nerSkills17_panel_118"><mxGeometry x="18" y="15" width="325.6666666666667" height="62.7" as="geometry" /></mxCell><mxCell id="nerSkills17_text_121" value="Maintain a deliberate form for the coming clash." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="nerSkills17_panel_118"><mxGeometry x="18" y="84.7" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_122" value="Effect" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="nerSkills17_panel_118"><mxGeometry x="18" y="116.60000000000001" width="325.6666666666667" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="nerSkills17_text_123" value="Apply Predatory Tissue and Dermal Plating to a&#10;living ally within 2 tiles for 2 of its activations, even if&#10;not learned separately. Includes -2 Speed; occupies&#10;one body-enhancement slot." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="nerSkills17_panel_118"><mxGeometry x="18" y="148.5" width="325.6666666666667" height="81.60000000000001" as="geometry" /></mxCell><mxCell id="nerSkills17_text_124" value="MECHANICAL CONTRACT / FIRST-PASS PROPOSAL" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=20;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1306.65" width="2300" height="33.0" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_125" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dfede4;strokeColor=#dfede4;" vertex="1" parent="1"><mxGeometry x="40" y="1354.65" width="2300" height="102.8" as="geometry" /></mxCell><mxCell id="nerSkills17_text_126" value="Nerath rulings" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="1366.65" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="nerSkills17_text_127" value="New temporary-unit proposal: a non-summoned enemy death leaves one corpse for this map; consuming it removes it. Corpses do not block tiles. A Husk acts once per player phase starting the phase after creation, lasts 3 of its activations, has no crit/counter/follow-up, and grants no XP, corpse or Echo on death. It may move then attack, cannot use items or mission&#10;interactions, and disappears at map end. Living excludes constructs and undead. Nerath buffs/debuffs are magical; body enhancements include Muscle Weave, Harden Skin, Nerve Surge, Predatory Tissue, Dermal Plating, Reflex Graft and their combined versions. Constructs and undead receive no biological healing." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="1398.65" width="2264" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_128" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dfede4;strokeColor=#dfede4;" vertex="1" parent="1"><mxGeometry x="40" y="1477.45" width="2300" height="121.69999999999999" as="geometry" /></mxCell><mxCell id="nerSkills17_text_129" value="Action and timing" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="1489.45" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="nerSkills17_text_130" value="First-pass design proposal, not an implementation claim. Numbers are starting balance values. One normal activation per unit each player phase: move, then one Action (attack, support, item or Wait). Actions end normal movement unless stated otherwise. Free and Mode skills do not spend that action. A round is one player phase plus one enemy phase; 1/round uses&#10;reset at player-phase start. Map uses reset only on a new battle or restart. Durations measured in target activations count the next N activation starts after application and end after the last such activation; a regeneration tick occurs at each counted start. An effect ending at your next activation expires before your movement; an effect ending at activation end may be&#10;used during it." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="1521.45" width="2264" height="62.7" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_131" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dfede4;strokeColor=#dfede4;" vertex="1" parent="1"><mxGeometry x="40" y="1619.15" width="2300" height="102.8" as="geometry" /></mxCell><mxCell id="nerSkills17_text_132" value="Combat and movement" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="1631.15" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="nerSkills17_text_133" value="An attack skill replaces the normal attack and uses normal hit, block, crit, counter and speed follow-up rules unless stated. One opening strike per initiated exchange; an ordinary melee strike uses Str + might vs Def, magic uses Mag + might vs Res. A single magical skill strike without listed Hit uses 85 Hit and no speed follow-up. Prevention of a counter also prevents&#10;defender follow-up and Riposte. All distances and adjacency are cardinal Manhattan distance. Movement must follow a walkable path with normal terrain costs unless stated; swaps and pushes require legal destinations. Bonus movement is not a new activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="1663.15" width="2264" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_134" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dfede4;strokeColor=#dfede4;" vertex="1" parent="1"><mxGeometry x="40" y="1741.95" width="2300" height="121.69999999999999" as="geometry" /></mxCell><mxCell id="nerSkills17_text_135" value="Stacking and reactions" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="1753.95" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="nerSkills17_text_136" value="Hit, Crit, Block and Avoid bonuses are percentage points. Round down fractional damage/healing unless specified; HP stays between 0 and maximum. Apply percentage damage changes to resolved strike damage after mitigation/block, before HP loss. Outgoing skill damage scalars multiply with the strongest applicable incoming damage reduction; multiple incoming&#10;reductions do not stack. Same-name bonuses refresh; different named stat bonuses stack, but each movement trigger grants a choice of one bonus move per exchange/action. Generated splash, turret, Husk and reaction strikes do not trigger additional skills unless explicitly stated. Death bookkeeping still runs; kills by a controlled Husk or turret credit the owner with&#10;normal killer XP. Temporary units themselves award no XP when destroyed. A defeated caster loses auras immediately, but already applied timed statuses expire normally. One interception per exchange; controller chooses among eligible defenders. Resolve displacement after combat, never midway through its strike order." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="1785.95" width="2264" height="62.7" as="geometry" /></mxCell><mxCell id="nerSkills17_panel_137" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dfede4;strokeColor=#dfede4;" vertex="1" parent="1"><mxGeometry x="40" y="1883.65" width="2300" height="102.8" as="geometry" /></mxCell><mxCell id="nerSkills17_text_138" value="Status and content boundaries" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="1895.65" width="2264" height="27.6" as="geometry" /></mxCell><mxCell id="nerSkills17_text_139" value="Pinned: -2 Move, minimum 1. Shaken: -15 Hit. Exposed: -3 Def and -3 Res. Bleed: lose 3 HP at each of the next 2 activation starts; can kill. Stat penalties never reduce Move below 1 unless explicitly 0. A target can hold one named body enhancement; replacing it does not erase owed penalties. Healing cannot revive; life-saving wards do not stack, and only one is&#10;consumed on a lethal strike. Proposed hooks include active skills, timed statuses, orders, entry reactions and temporary units; implement those hooks before shipping these definitions. These pages do not alter Mihata or grant new permanent campaign systems." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="1927.65" width="2264" height="43.800000000000004" as="geometry" /></mxCell></root></mxGraphModel></diagram>
  <diagram id="ner17" name="Nerath Houses"><mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="3539" math="0" shadow="0" background="#f7f4ee"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ner17_panel_1" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1660" height="12" as="geometry" /></mxCell><mxCell id="ner17_text_2" value="NERATH / THE BODY IS A POSSIBILITY" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=32;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="35" width="1580" height="49.2" as="geometry" /></mxCell><mxCell id="ner17_text_3" value="Physicians, death-workers and flesh-shapers share anatomical knowledge. Outsiders fear what these houses can do; patients know why it matters." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="92.2" width="1580" height="27.6" as="geometry" /></mxCell><mxCell id="ner17_panel_4" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dfede4;strokeColor=#dfede4;" vertex="1" parent="1"><mxGeometry x="40" y="131.8" width="1580" height="102.8" as="geometry" /></mxCell><mxCell id="ner17_text_5" value="Build direction — proposal for review" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="143.8" width="1544" height="27.6" as="geometry" /></mxCell><mxCell id="ner17_text_6" value="Follow one connected promotion path. Each class contributes the two skills printed on its card; keep learned ancestor skills, with explicit upgrades replacing earlier versions. No attribute gates are proposed. Six separate discipline choices allow personal&#10;variation; choose one per numbered column, two per tier. Unlock levels, point costs, respec rules and exact balance still need confirmation. This proposal does not change the implemented class-selection system." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="175.8" width="1544" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="ner17_text_7" value="RESTORATIVE HOUSES" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=24;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="274.6" width="1580" height="38.400000000000006" as="geometry" /></mxCell><mxCell id="ner17_text_8" value="Healing as decisive field medicine. Rescue someone at the moment the line would break." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=15;fontColor=#202b30;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="316.0" width="1580" height="26.25" as="geometry" /></mxCell><mxCell id="ner17_text_9" value="DISCIPLINE" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="357.25" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="ner17_text_10" value="SPECIALIZATION" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="357.25" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="ner17_text_11" value="MASTERY" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="357.25" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="ner17_panel_12" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="600" y="389.25" width="440" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="ner17_panel_13" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="600" y="389.25" width="5" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="ner17_text_14" value="Physician" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="ner17_panel_12"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="ner17_text_15" value="Treat the cause, not only the missing health." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="ner17_panel_12"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_16" value="Combat Surgery [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_12"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_17" value="Heal an adjacent living ally for 10 + floor(Mag/2) HP and remove&#10;either Bleed, Pinned or Shaken." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_12"><mxGeometry x="18" y="120.15" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="ner17_text_18" value="Recovery Position [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_12"><mxGeometry x="18" y="170.95000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_19" value="An ally healed by Combat Surgery takes 25% less damage from&#10;its next strike before your next activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_12"><mxGeometry x="18" y="202.85000000000002" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="ner17_panel_20" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1140" y="389.25" width="440" height="310.45" as="geometry" /></mxCell><mxCell id="ner17_panel_21" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="1140" y="389.25" width="5" height="310.45" as="geometry" /></mxCell><mxCell id="ner17_text_22" value="Chirurgeon" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="ner17_panel_20"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="ner17_text_23" value="Perform the impossible procedure, then depend on the team to&#10;cover you." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="ner17_panel_20"><mxGeometry x="18" y="56.35" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="ner17_text_24" value="Reconstruct [Action; 1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_20"><mxGeometry x="18" y="107.15" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_25" value="Heal a living ally within 2 tiles to at least 70% maximum HP and&#10;remove Bleed, Pinned, Shaken and Exposed. Never reduces&#10;current HP." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_20"><mxGeometry x="18" y="139.05" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="ner17_text_26" value="Decisive Intervention [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_20"><mxGeometry x="18" y="208.75" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_27" value="After Reconstruct, the target gains +3 Def/+3 Res until your next&#10;activation. You cannot counter until then." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_20"><mxGeometry x="18" y="240.65" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="ner17_edge_28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#32685d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ner17_panel_12" target="ner17_panel_20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ner17_panel_29" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="600" y="723.7" width="440" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="ner17_panel_30" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="600" y="723.7" width="5" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="ner17_text_31" value="Regenerator" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="ner17_panel_29"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="ner17_text_32" value="Prepare a body to recover through a sustained fight." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="ner17_panel_29"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_33" value="Living Graft [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_29"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_34" value="Give one living ally within 2 tiles regeneration: heal 5 +&#10;floor(Mag/3) HP at the start of each of its next 2 activations." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_29"><mxGeometry x="18" y="120.15" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="ner17_text_35" value="Adaptive Tissue [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_29"><mxGeometry x="18" y="170.95000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_36" value="Give one living ally within 2 tiles +4 Def or +4 Res until your next&#10;activation. Choose which; the two modes cannot stack." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_29"><mxGeometry x="18" y="202.85000000000002" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="ner17_panel_37" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1140" y="723.7" width="440" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="ner17_panel_38" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="1140" y="723.7" width="5" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="ner17_text_39" value="Lifeshaper" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="ner17_panel_37"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="ner17_text_40" value="Build a survivor, not a patient who needs constant rescue." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="ner17_panel_37"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_41" value="Perfect Graft [Upgrade]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_37"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_42" value="Living Graft lasts for 3 target activations. Its first healing tick also&#10;removes Bleed." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_37"><mxGeometry x="18" y="120.15" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="ner17_text_43" value="Renewal [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_37"><mxGeometry x="18" y="170.95000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_44" value="Consume your Living Graft on an ally within 3 tiles. Immediately&#10;heal 8 HP per remaining tick. All future ticks are removed." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_37"><mxGeometry x="18" y="202.85000000000002" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="ner17_edge_45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#32685d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ner17_panel_29" target="ner17_panel_37"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ner17_panel_46" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="60" y="556.4750000000001" width="440" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="ner17_panel_47" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="60" y="556.4750000000001" width="5" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="ner17_text_48" value="Vitalist" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="ner17_panel_46"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="ner17_text_49" value="Read the wound and restore the person." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="ner17_panel_46"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_50" value="Mend [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_46"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_51" value="Heal one living ally at range 1-2 for 8 + floor(Mag/2) HP. May&#10;target self." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_46"><mxGeometry x="18" y="120.15" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="ner17_text_52" value="Triage [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_46"><mxGeometry x="18" y="170.95000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_53" value="Your healing restores 4 extra HP if its recipient is below 40% HP&#10;before the heal." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_46"><mxGeometry x="18" y="202.85000000000002" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="ner17_edge_54" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#32685d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ner17_panel_46" target="ner17_panel_12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ner17_edge_55" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#32685d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ner17_panel_46" target="ner17_panel_29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ner17_text_56" value="DEATH HOUSES" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=24;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1064.3500000000001" width="1580" height="38.400000000000006" as="geometry" /></mxCell><mxCell id="ner17_text_57" value="The dead remain useful, but never disposable without a choice. Bodies occupy space; echoes preserve resolve." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=15;fontColor=#202b30;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1105.7500000000002" width="1580" height="26.25" as="geometry" /></mxCell><mxCell id="ner17_text_58" value="DISCIPLINE" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1147.0000000000002" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="ner17_text_59" value="SPECIALIZATION" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="1147.0000000000002" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="ner17_text_60" value="MASTERY" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="1147.0000000000002" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="ner17_panel_61" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="600" y="1179.0000000000002" width="440" height="310.45" as="geometry" /></mxCell><mxCell id="ner17_panel_62" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="600" y="1179.0000000000002" width="5" height="310.45" as="geometry" /></mxCell><mxCell id="ner17_text_63" value="Necromancer" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="ner17_panel_61"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="ner17_text_64" value="Put a fallen body back on the line, and decide where it is worth&#10;spending." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="ner17_panel_61"><mxGeometry x="18" y="56.35" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="ner17_text_65" value="Raise Husk [Action; 2/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_61"><mxGeometry x="18" y="107.15" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_66" value="Consume an enemy corpse within 2 tiles. Create one Husk there&#10;or on a free adjacent tile: 12 HP, Move 3, range 1, 4 physical&#10;power, 80 Hit, Def/Res 0. Maximum 1 Husk." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_61"><mxGeometry x="18" y="139.05" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="ner17_text_67" value="Grave Exchange [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_61"><mxGeometry x="18" y="208.75" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_68" value="Swap with your Husk within 4 tiles if both destinations are legal.&#10;This spends your action; it does not activate the Husk." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_61"><mxGeometry x="18" y="240.65" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="ner17_panel_69" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1140" y="1179.0000000000002" width="440" height="291.55" as="geometry" /></mxCell><mxCell id="ner17_panel_70" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="1140" y="1179.0000000000002" width="5" height="291.55" as="geometry" /></mxCell><mxCell id="ner17_text_71" value="Gravebinder" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="ner17_panel_69"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="ner17_text_72" value="Command a small procession rather than an endless army." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="ner17_panel_69"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_73" value="Twofold Grave [Upgrade]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_69"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_74" value="Raise Husk has 3 uses per map and you may maintain 2 Husks.&#10;Each lasts for 3 of its own activations." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_69"><mxGeometry x="18" y="120.15" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="ner17_text_75" value="Return to Dust [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_69"><mxGeometry x="18" y="170.95000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_76" value="Dismiss one of your Husks within 4 tiles. Heal a living ally&#10;adjacent to that Husk for 10 + floor(Mag/2) HP. Dismissal leaves&#10;no corpse or Echo." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_69"><mxGeometry x="18" y="202.85000000000002" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="ner17_edge_77" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#32685d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ner17_panel_61" target="ner17_panel_69"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ner17_panel_78" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="600" y="1513.4500000000003" width="440" height="291.55" as="geometry" /></mxCell><mxCell id="ner17_panel_79" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="600" y="1513.4500000000003" width="5" height="291.55" as="geometry" /></mxCell><mxCell id="ner17_text_80" value="Medium" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="ner17_panel_78"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="ner17_text_81" value="Carry the last resolve of the dead into the next living choice." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="ner17_panel_78"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_82" value="Echo Ward [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_78"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_83" value="An ally within 3 tiles gains +4 Res until your next activation. You&#10;may spend an Echo to also ward their next strike for 30% less&#10;damage." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_78"><mxGeometry x="18" y="120.15" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="ner17_text_84" value="Spirit Vessel [Upgrade]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_78"><mxGeometry x="18" y="189.85000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_85" value="Store up to 2 Echoes. Last Breath grants at most 1 per death, and&#10;only from non-summoned living units." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_78"><mxGeometry x="18" y="221.75000000000003" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="ner17_panel_86" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1140" y="1513.4500000000003" width="440" height="310.45000000000005" as="geometry" /></mxCell><mxCell id="ner17_panel_87" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="1140" y="1513.4500000000003" width="5" height="310.45000000000005" as="geometry" /></mxCell><mxCell id="ner17_text_88" value="Soulkeeper" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="ner17_panel_86"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="ner17_text_89" value="Spend a saved memory when a living companion needs it most." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="ner17_panel_86"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_90" value="Soul Anchor [Action; 1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_86"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_91" value="Spend 1 Echo to ward a living ally within 3 tiles until your next&#10;activation. Their next lethal strike leaves 1 HP and consumes the&#10;ward." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_86"><mxGeometry x="18" y="120.15" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="ner17_text_92" value="Bequeath Resolve [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_86"><mxGeometry x="18" y="189.85000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_93" value="Spend 1 Echo. A living ally within 3 tiles gains +3 attack power&#10;and +15 Hit for its next initiated combat before your next&#10;activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_86"><mxGeometry x="18" y="221.75000000000003" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="ner17_edge_94" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#32685d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ner17_panel_78" target="ner17_panel_86"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ner17_panel_95" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="60" y="1355.6750000000002" width="440" height="291.55" as="geometry" /></mxCell><mxCell id="ner17_panel_96" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="60" y="1355.6750000000002" width="5" height="291.55" as="geometry" /></mxCell><mxCell id="ner17_text_97" value="Thanaturge" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="ner17_panel_95"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="ner17_text_98" value="Study the boundary between the last breath and what follows." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="ner17_panel_95"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_99" value="Grave Touch [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_95"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_100" value="Make one magical strike at range 1-2 with power Mag + 4&#10;against Res. Gain +3 power if the target is below 50% HP." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_95"><mxGeometry x="18" y="120.15" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="ner17_text_101" value="Last Breath [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_95"><mxGeometry x="18" y="170.95000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_102" value="When a living unit dies within 3 tiles, gain one Echo, maximum 1.&#10;Spend it to add +4 HP to your next heal or +4 power to your&#10;next Grave Touch." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_95"><mxGeometry x="18" y="202.85000000000002" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="ner17_edge_103" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#32685d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ner17_panel_95" target="ner17_panel_61"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ner17_edge_104" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#32685d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ner17_panel_95" target="ner17_panel_78"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ner17_text_105" value="FLESH HOUSES" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=24;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1891.9000000000003" width="1580" height="38.400000000000006" as="geometry" /></mxCell><mxCell id="ner17_text_106" value="Shape a body for a purpose. Choose the strength and accept the cost." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=15;fontColor=#202b30;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1933.3000000000004" width="1580" height="26.25" as="geometry" /></mxCell><mxCell id="ner17_text_107" value="DISCIPLINE" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1974.5500000000004" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="ner17_text_108" value="SPECIALIZATION" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="1974.5500000000004" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="ner17_text_109" value="MASTERY" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=13;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="1974.5500000000004" width="440" height="23.55" as="geometry" /></mxCell><mxCell id="ner17_panel_110" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="600" y="2006.5500000000004" width="440" height="291.55" as="geometry" /></mxCell><mxCell id="ner17_panel_111" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="600" y="2006.5500000000004" width="5" height="291.55" as="geometry" /></mxCell><mxCell id="ner17_text_112" value="Hemomancer" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="ner17_panel_110"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="ner17_text_113" value="Your own blood is a resource, but the price is always visible." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="ner17_panel_110"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_114" value="Sanguine Link [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_110"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_115" value="Pay up to 8 HP, never below 1, to heal a living ally within 2 tiles&#10;for twice the HP paid. Choose the amount before confirmation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_110"><mxGeometry x="18" y="120.15" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="ner17_text_116" value="Blood Mark [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_110"><mxGeometry x="18" y="170.95000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_117" value="One visible enemy within 3 tiles is marked until your next&#10;activation. Each ally's first damaging strike against it heals that&#10;attacker for 4 HP, once per ally." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_110"><mxGeometry x="18" y="202.85000000000002" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="ner17_panel_118" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1140" y="2006.5500000000004" width="440" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="ner17_panel_119" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="1140" y="2006.5500000000004" width="5" height="272.65000000000003" as="geometry" /></mxCell><mxCell id="ner17_text_120" value="Blood Sage" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="ner17_panel_118"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="ner17_text_121" value="Keep a dangerous circulation of sacrifice and recovery moving." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="ner17_panel_118"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_122" value="Shared Pulse [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_118"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_123" value="After Sanguine Link heals, recover half the HP you paid, rounded&#10;down. This recovery cannot trigger healing skills." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_118"><mxGeometry x="18" y="120.15" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="ner17_text_124" value="Crimson Reserve [Action; 1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_118"><mxGeometry x="18" y="170.95000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_125" value="Pay 20% maximum HP, rounded up, without falling below 1. Heal&#10;up to 3 other living allies within 2 tiles for 12 HP each." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_118"><mxGeometry x="18" y="202.85000000000002" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="ner17_edge_126" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#32685d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ner17_panel_110" target="ner17_panel_118"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ner17_panel_127" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="600" y="2322.1000000000004" width="440" height="310.45000000000005" as="geometry" /></mxCell><mxCell id="ner17_panel_128" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="600" y="2322.1000000000004" width="5" height="310.45000000000005" as="geometry" /></mxCell><mxCell id="ner17_text_129" value="Fleshweaver" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="ner17_panel_127"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="ner17_text_130" value="Rebuild a fighter for this exact encounter." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="ner17_panel_127"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_131" value="Nerve Surge [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_127"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_132" value="One living ally within 2 tiles gains +2 Speed and +15 Hit until&#10;your next activation; afterward it loses 1 Move during its next&#10;activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_127"><mxGeometry x="18" y="120.15" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="ner17_text_133" value="Repattern [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_127"><mxGeometry x="18" y="189.85000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_134" value="Replace your Muscle Weave, Harden Skin or Nerve Surge on an&#10;ally within 3 tiles with another of those effects you know. Apply&#10;its full duration; owed penalties remain." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_127"><mxGeometry x="18" y="221.75000000000003" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="ner17_panel_135" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="1140" y="2322.1000000000004" width="440" height="310.45" as="geometry" /></mxCell><mxCell id="ner17_panel_136" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="1140" y="2322.1000000000004" width="5" height="310.45" as="geometry" /></mxCell><mxCell id="ner17_text_137" value="Grand Morph" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="ner17_panel_135"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="ner17_text_138" value="Create a deliberate masterpiece, not a pile of permanent stat&#10;bonuses." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="ner17_panel_135"><mxGeometry x="18" y="56.35" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="ner17_text_139" value="Perfected Frame [Action; 1/map]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_135"><mxGeometry x="18" y="107.15" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_140" value="Apply both Muscle Weave and Harden Skin to one living ally&#10;within 2 tiles for 2 of its activations. Include both penalties;&#10;occupies its single enhancement slot." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_135"><mxGeometry x="18" y="139.05" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="ner17_text_141" value="Adaptive Recovery [Passive]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_135"><mxGeometry x="18" y="208.75" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_142" value="When one of your body enhancements expires or is replaced on a&#10;living ally, heal it for 5 HP, at most once per target per round." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_135"><mxGeometry x="18" y="240.65" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="ner17_edge_143" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#32685d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ner17_panel_127" target="ner17_panel_135"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ner17_panel_144" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#d8d5cf;" vertex="1" parent="1"><mxGeometry x="60" y="2173.775" width="440" height="291.55" as="geometry" /></mxCell><mxCell id="ner17_panel_145" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#32685d;strokeColor=#32685d;" vertex="1" parent="1"><mxGeometry x="60" y="2173.775" width="5" height="291.55" as="geometry" /></mxCell><mxCell id="ner17_text_146" value="Biomancer" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=21;fontColor=#32685d;fontStyle=1;" vertex="1" parent="ner17_panel_144"><mxGeometry x="18" y="15" width="404" height="34.35" as="geometry" /></mxCell><mxCell id="ner17_text_147" value="Every enhancement changes what a body is good at." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#59636a;fontStyle=2;" vertex="1" parent="ner17_panel_144"><mxGeometry x="18" y="56.35" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_148" value="Muscle Weave [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_144"><mxGeometry x="18" y="88.25" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_149" value="One living ally within 2 tiles gains +4 physical power and loses 2&#10;Speed until your next activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_144"><mxGeometry x="18" y="120.15" width="404" height="43.800000000000004" as="geometry" /></mxCell><mxCell id="ner17_text_150" value="Harden Skin [Action]" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=1;" vertex="1" parent="ner17_panel_144"><mxGeometry x="18" y="170.95000000000002" width="404" height="24.900000000000002" as="geometry" /></mxCell><mxCell id="ner17_text_151" value="One living ally within 2 tiles gains +4 Def and loses 1 Move,&#10;minimum 1, until your next activation. Replaces Muscle Weave on&#10;that target." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="ner17_panel_144"><mxGeometry x="18" y="202.85000000000002" width="404" height="62.7" as="geometry" /></mxCell><mxCell id="ner17_edge_152" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#32685d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ner17_panel_144" target="ner17_panel_110"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ner17_edge_153" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#32685d;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ner17_panel_144" target="ner17_panel_127"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ner17_text_154" value="MECHANICAL CONTRACT / FIRST-PASS PROPOSAL" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=20;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="2696.55" width="1580" height="33.0" as="geometry" /></mxCell><mxCell id="ner17_panel_155" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dfede4;strokeColor=#dfede4;" vertex="1" parent="1"><mxGeometry x="40" y="2744.55" width="1580" height="121.69999999999999" as="geometry" /></mxCell><mxCell id="ner17_text_156" value="Nerath rulings" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="2756.55" width="1544" height="27.6" as="geometry" /></mxCell><mxCell id="ner17_text_157" value="New temporary-unit proposal: a non-summoned enemy death leaves one corpse for this map; consuming it removes it. Corpses do not block tiles. A Husk acts once per player phase starting the phase after creation, lasts 3 of its activations, has no&#10;crit/counter/follow-up, and grants no XP, corpse or Echo on death. It may move then attack, cannot use items or mission interactions, and disappears at map end. Living excludes constructs and undead. Nerath buffs/debuffs are magical; body&#10;enhancements include Muscle Weave, Harden Skin, Nerve Surge, Predatory Tissue, Dermal Plating, Reflex Graft and their combined versions. Constructs and undead receive no biological healing." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="2788.55" width="1544" height="62.7" as="geometry" /></mxCell><mxCell id="ner17_panel_158" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dfede4;strokeColor=#dfede4;" vertex="1" parent="1"><mxGeometry x="40" y="2886.25" width="1580" height="140.6" as="geometry" /></mxCell><mxCell id="ner17_text_159" value="Action and timing" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="2898.25" width="1544" height="27.6" as="geometry" /></mxCell><mxCell id="ner17_text_160" value="First-pass design proposal, not an implementation claim. Numbers are starting balance values. One normal activation per unit each player phase: move, then one Action (attack, support, item or Wait). Actions end normal movement unless stated&#10;otherwise. Free and Mode skills do not spend that action. A round is one player phase plus one enemy phase; 1/round uses reset at player-phase start. Map uses reset only on a new battle or restart. Durations measured in target activations count the&#10;next N activation starts after application and end after the last such activation; a regeneration tick occurs at each counted start. An effect ending at your next activation expires before your movement; an effect ending at activation end may be used&#10;during it." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="2930.25" width="1544" height="81.60000000000001" as="geometry" /></mxCell><mxCell id="ner17_panel_161" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dfede4;strokeColor=#dfede4;" vertex="1" parent="1"><mxGeometry x="40" y="3046.85" width="1580" height="121.69999999999999" as="geometry" /></mxCell><mxCell id="ner17_text_162" value="Combat and movement" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="3058.85" width="1544" height="27.6" as="geometry" /></mxCell><mxCell id="ner17_text_163" value="An attack skill replaces the normal attack and uses normal hit, block, crit, counter and speed follow-up rules unless stated. One opening strike per initiated exchange; an ordinary melee strike uses Str + might vs Def, magic uses Mag + might vs Res. A&#10;single magical skill strike without listed Hit uses 85 Hit and no speed follow-up. Prevention of a counter also prevents defender follow-up and Riposte. All distances and adjacency are cardinal Manhattan distance. Movement must follow a walkable path&#10;with normal terrain costs unless stated; swaps and pushes require legal destinations. Bonus movement is not a new activation." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="3090.85" width="1544" height="62.7" as="geometry" /></mxCell><mxCell id="ner17_panel_164" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dfede4;strokeColor=#dfede4;" vertex="1" parent="1"><mxGeometry x="40" y="3188.5499999999997" width="1580" height="159.5" as="geometry" /></mxCell><mxCell id="ner17_text_165" value="Stacking and reactions" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="3200.5499999999997" width="1544" height="27.6" as="geometry" /></mxCell><mxCell id="ner17_text_166" value="Hit, Crit, Block and Avoid bonuses are percentage points. Round down fractional damage/healing unless specified; HP stays between 0 and maximum. Apply percentage damage changes to resolved strike damage after mitigation/block, before HP loss.&#10;Outgoing skill damage scalars multiply with the strongest applicable incoming damage reduction; multiple incoming reductions do not stack. Same-name bonuses refresh; different named stat bonuses stack, but each movement trigger grants a choice&#10;of one bonus move per exchange/action. Generated splash, turret, Husk and reaction strikes do not trigger additional skills unless explicitly stated. Death bookkeeping still runs; kills by a controlled Husk or turret credit the owner with normal killer XP.&#10;Temporary units themselves award no XP when destroyed. A defeated caster loses auras immediately, but already applied timed statuses expire normally. One interception per exchange; controller chooses among eligible defenders. Resolve displacement&#10;after combat, never midway through its strike order." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="3232.5499999999997" width="1544" height="100.50000000000001" as="geometry" /></mxCell><mxCell id="ner17_panel_167" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dfede4;strokeColor=#dfede4;" vertex="1" parent="1"><mxGeometry x="40" y="3368.0499999999997" width="1580" height="121.69999999999999" as="geometry" /></mxCell><mxCell id="ner17_text_168" value="Status and content boundaries" style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#32685d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="58" y="3380.0499999999997" width="1544" height="27.6" as="geometry" /></mxCell><mxCell id="ner17_text_169" value="Pinned: -2 Move, minimum 1. Shaken: -15 Hit. Exposed: -3 Def and -3 Res. Bleed: lose 3 HP at each of the next 2 activation starts; can kill. Stat penalties never reduce Move below 1 unless explicitly 0. A target can hold one named body enhancement;&#10;replacing it does not erase owed penalties. Healing cannot revive; life-saving wards do not stack, and only one is consumed on a lethal strike. Proposed hooks include active skills, timed statuses, orders, entry reactions and temporary units; implement&#10;those hooks before shipping these definitions. These pages do not alter Mihata or grant new permanent campaign systems." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;fillColor=none;strokeColor=none;fontFamily=Segoe UI;fontSize=14;fontColor=#202b30;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="58" y="3412.0499999999997" width="1544" height="62.7" as="geometry" /></mxCell></root></mxGraphModel></diagram>
