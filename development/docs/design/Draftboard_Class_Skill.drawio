          <mxGeometry height="85" width="160" x="300" y="320" as="geometry" />
        </mxCell>
        <mxCell id="e_mih_base_mih_sword" edge="1" parent="1" source="mih_base" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" target="mih_sword">
