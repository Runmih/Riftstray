        <mxCell id="pot_heal" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#e1d5e7,#2c2034);strokeColor=#9673a6;fontSize=12;fontColor=light-dark(#111111,#ffffff);" value="&lt;strong&gt;Mending Draught&lt;/strong&gt;:&lt;div&gt;Restore 35% max HP. 2 uses per map.&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="240" x="877" y="340" as="geometry" />
        </mxCell>
        <mxCell id="pot_stone" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#e1d5e7,#2c2034);strokeColor=#9673a6;fontSize=12;fontColor=light-dark(#111111,#ffffff);" value="&lt;strong&gt;Stonehide Tonic&lt;/strong&gt;:&lt;div&gt;+5 Def and +3 Res for 2 turns, but -2 Spd while active.&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="240" x="1158" y="340" as="geometry" />
        </mxCell>
        <mxCell id="pot_redline" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#e1d5e7,#2c2034);strokeColor=#9673a6;fontSize=12;fontColor=light-dark(#111111,#ffffff);" value="&lt;strong&gt;Redline Tonic&lt;/strong&gt;:&lt;div&gt;+2 Move and +4 Atk for 1 turn; next turn suffer -2 Move and -4 Def.&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="240" x="1420" y="340" as="geometry" />
        </mxCell>
        <mxCell id="qrUlXLS8Ja-MGCBHV1_3-4" edge="1" parent="1" source="mih_control" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="beast_class">
